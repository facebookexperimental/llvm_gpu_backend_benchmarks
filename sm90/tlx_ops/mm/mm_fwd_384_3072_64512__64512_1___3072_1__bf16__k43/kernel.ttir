module {
  tt.func public @_small_k_kernel(%a_desc: !tt.tensordesc<128x64xbf16>, %a_desc.shape.0: i32, %a_desc.shape.1: i32, %a_desc.stride.0: i64, %a_desc.stride.1: i64, %b_desc: !tt.tensordesc<64x256xbf16>, %b_desc.shape.0: i32, %b_desc.shape.1: i32, %b_desc.stride.0: i64, %b_desc.stride.1: i64, %c_desc: !tt.tensordesc<128x256xbf16>, %c_desc.shape.0: i32, %c_desc.shape.1: i32, %c_desc.stride.0: i64, %c_desc.stride.1: i64, %workspace_desc: !tt.tensordesc<128x256xf32>, %workspace_desc.shape.0: i32, %workspace_desc.shape.1: i32, %workspace_desc.stride.0: i64, %workspace_desc.stride.1: i64, %bias_ptr: !tt.ptr<bf16> {tt.divisibility = 16 : i32}, %M: i32 {tt.divisibility = 16 : i32}, %N: i32 {tt.divisibility = 16 : i32}, %K: i32 {tt.divisibility = 16 : i32}, %stride_bias: i32 {tt.divisibility = 16 : i32}) attributes {noinline = false} {
    %acc = arith.constant dense<0.000000e+00> : tensor<128x256xf32>
    %k_tiles = arith.constant 63 : i32
    %k_tiles_per_split = arith.constant 3 : i32
    %k_tiles_per_split_0 = arith.constant 2 : i32
    %num_pid_n = arith.constant 255 : i32
    %num_pid_m = arith.constant 127 : i32
    %c1_i32 = arith.constant 1 : i32
    %c64_i32 = arith.constant 64 : i32
    %c256_i32 = arith.constant 256 : i32
    %c128_i32 = arith.constant 128 : i32
    %c8_i32 = arith.constant 8 : i32
    %pid = tt.get_program_id x : i32
    %split_id = tt.get_program_id y : i32
    %num_pid_m_1 = arith.addi %M, %num_pid_m : i32
    %num_pid_m_2 = arith.divsi %num_pid_m_1, %c128_i32 : i32
    %num_pid_n_3 = arith.addi %N, %num_pid_n : i32
    %num_pid_n_4 = arith.divsi %num_pid_n_3, %c256_i32 : i32
    %num_pid_in_group = arith.muli %num_pid_n_4, %c8_i32 : i32
    %first_pid_m = arith.divsi %pid, %num_pid_in_group : i32
    %first_pid_m_5 = arith.muli %first_pid_m, %c8_i32 : i32
    %group_size_m = arith.subi %num_pid_m_2, %first_pid_m_5 : i32
    %group_size_m_6 = arith.minsi %group_size_m, %c8_i32 : i32
    %pid_m = arith.remsi %pid, %num_pid_in_group : i32
    %pid_m_7 = arith.remsi %pid_m, %group_size_m_6 : i32
    %pid_m_8 = arith.addi %first_pid_m_5, %pid_m_7 : i32
    %pid_n = arith.divsi %pid_m, %group_size_m_6 : i32
    %offs_m = arith.muli %pid_m_8, %c128_i32 : i32
    %offs_n = arith.muli %pid_n, %c256_i32 : i32
    %k_tiles_9 = arith.addi %K, %k_tiles : i32
    %k_tiles_10 = arith.divsi %k_tiles_9, %c64_i32 : i32
    %k_tiles_per_split_11 = arith.addi %k_tiles_10, %k_tiles_per_split_0 : i32
    %k_tiles_per_split_12 = arith.divsi %k_tiles_per_split_11, %k_tiles_per_split : i32
    %k_lo = arith.muli %split_id, %k_tiles_per_split_12 : i32
    %0 = arith.addi %k_lo, %k_tiles_per_split_12 : i32
    %1 = arith.minsi %0, %k_tiles_10 : i32
    %acc_13 = scf.for %k = %k_lo to %1 step %c1_i32 iter_args(%acc_14 = %acc) -> (tensor<128x256xf32>)  : i32 {
      %offs_k = arith.muli %k, %c64_i32 : i32
      %a = tt.descriptor_load %a_desc[%offs_m, %offs_k] : !tt.tensordesc<128x64xbf16> -> tensor<128x64xbf16>
      %b = tt.descriptor_load %b_desc[%offs_k, %offs_n] : !tt.tensordesc<64x256xbf16> -> tensor<64x256xbf16>
      %acc_15 = tt.dot %a, %b, %acc_14, inputPrecision = tf32 : tensor<128x64xbf16> * tensor<64x256xbf16> -> tensor<128x256xf32>
      scf.yield %acc_15 : tensor<128x256xf32>
    }
    %2 = arith.muli %split_id, %num_pid_m_2 : i32
    %3 = arith.muli %2, %c128_i32 : i32
    %4 = arith.addi %3, %offs_m : i32
    tt.descriptor_store %workspace_desc[%4, %offs_n], %acc_13 : !tt.tensordesc<128x256xf32>, tensor<128x256xf32>
    tt.return
  }
}
