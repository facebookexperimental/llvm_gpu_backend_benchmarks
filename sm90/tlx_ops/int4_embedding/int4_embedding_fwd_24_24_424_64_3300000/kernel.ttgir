    %10 = tt.addptr %8, %9 : tensor<32x64x!tt.ptr<f16>, #blocked>, tensor<32x64xi32, #blocked>
    %11 = tt.broadcast %0 : tensor<32x1xi1, #blocked> -> tensor<32x64xi1, #blocked>
    tt.store %10, %vals_112, %11 : tensor<32x64x!tt.ptr<f16>, #blocked>
    tt.return
  }
}
