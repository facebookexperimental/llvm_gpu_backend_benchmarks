    } : (i32, i32, !tt.ptr<f16>, i32, i32, i32, i32, i32, i32, !tt.ptr<f16>, !ttg.memdesc<2x128x64xf16, #shared, #smem, mutable>, !tt.ptr<f32>, !tt.ptr<i8>, i32, !ttg.memdesc<6xi64, #shared1, #smem, mutable>, !ttg.memdesc<6xi64, #shared1, #smem, mutable>, !ttg.memdesc<6x128x64xf16, #shared, #smem, mutable>, !ttg.memdesc<1xi64, #shared1, #smem, mutable>, !ttg.memdesc<1xi64, #shared1, #smem, mutable>, !ttg.memdesc<6x128x64xf16, #shared, #smem, mutable>) -> ()
    tt.return
  }
}
