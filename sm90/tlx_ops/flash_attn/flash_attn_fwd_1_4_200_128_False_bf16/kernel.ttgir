    %out_ptrs_65 = tt.addptr %out_ptrs_63, %out_ptrs_64 : !tt.ptr<bf16>, i32
    %out_ptrs_66 = tt.splat %stride_om : i32 -> tensor<32x1xi32, #blocked>
    %out_ptrs_67 = arith.muli %q_ptrs_17, %out_ptrs_66 : tensor<32x1xi32, #blocked>
