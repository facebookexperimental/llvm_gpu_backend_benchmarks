    %out_ptrs_69 = tt.addptr %out_ptrs_68, %out_ptrs_67 : tensor<32x1x!tt.ptr<bf16>, #blocked>, tensor<32x1xi32, #blocked>
    %out_ptrs_70 = tt.broadcast %out_ptrs_69 : tensor<32x1x!tt.ptr<bf16>, #blocked> -> tensor<32x128x!tt.ptr<bf16>, #blocked>
    %out_ptrs_71 = tt.addptr %out_ptrs_70, %q_ptrs_24 : tensor<32x128x!tt.ptr<bf16>, #blocked>, tensor<32x128xi32, #blocked>
    %0 = arith.truncf %acc_62 : tensor<32x128xf32, #mma> to tensor<32x128xbf16, #mma>
    %1 = ttg.convert_layout %0 : tensor<32x128xbf16, #mma> -> tensor<32x128xbf16, #blocked>
    tt.store %out_ptrs_71, %1, %q_tile_29 : tensor<32x128x!tt.ptr<bf16>, #blocked>
