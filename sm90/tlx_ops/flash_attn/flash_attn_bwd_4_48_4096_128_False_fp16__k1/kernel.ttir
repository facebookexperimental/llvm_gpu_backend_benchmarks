    %off_m_1 = arith.muli %off_m, %c128_i32 : i32
    %off_m_2 = tt.make_range {end = 128 : i32, start = 0 : i32} : tensor<128xi32>
    %off_m_3 = tt.splat %off_m_1 : i32 -> tensor<128xi32>
    %off_m_4 = arith.addi %off_m_3, %off_m_2 : tensor<128xi32>
    %off_hz = tt.get_program_id y : i32
    %mask_5 = tt.expand_dims %off_m_4 {axis = 1 : i32} : tensor<128xi32> -> tensor<128x1xi32>
    %mask_6 = tt.splat %N_CTX : i32 -> tensor<128x1xi32>
    %mask_7 = arith.cmpi slt, %mask_5, %mask_6 : tensor<128x1xi32>
