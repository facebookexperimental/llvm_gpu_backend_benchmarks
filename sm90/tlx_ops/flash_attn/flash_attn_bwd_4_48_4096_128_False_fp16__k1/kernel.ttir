    tt.store %5, %delta_29, %1 : tensor<128x!tt.ptr<f32>>
    %6 = tt.addptr %DQ, %o_13 : !tt.ptr<f16>, i32
    %7 = tt.splat %6 : !tt.ptr<f16> -> tensor<128x1x!tt.ptr<f16>>
    %8 = tt.addptr %7, %o_15 : tensor<128x1x!tt.ptr<f16>>, tensor<128x1xi32>
    %9 = tt.broadcast %8 : tensor<128x1x!tt.ptr<f16>> -> tensor<128x128x!tt.ptr<f16>>
    %10 = tt.addptr %9, %o_19 : tensor<128x128x!tt.ptr<f16>>, tensor<128x128xi32>
    tt.store %10, %cst, %mask_12 : tensor<128x128x!tt.ptr<f16>>
    tt.return
  }
}
