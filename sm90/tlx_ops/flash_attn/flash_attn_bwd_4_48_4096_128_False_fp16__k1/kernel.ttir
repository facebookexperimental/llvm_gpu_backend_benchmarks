module {
  tt.func public @_attn_bwd_preprocess(%O: !tt.ptr<f16> {tt.divisibility = 16 : i32}, %DO: !tt.ptr<f16> {tt.divisibility = 16 : i32}, %Delta: !tt.ptr<f32> {tt.divisibility = 16 : i32}, %DQ: !tt.ptr<f16> {tt.divisibility = 16 : i32}, %N_CTX: i32 {tt.divisibility = 16 : i32}) attributes {noinline = false} {
    %cst = arith.constant dense<0.000000e+00> : tensor<128x128xf16>
