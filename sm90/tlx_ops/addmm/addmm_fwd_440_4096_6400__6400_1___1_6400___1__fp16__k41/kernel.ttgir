    } : (i32, i32, i32, !ttg.memdesc<8x64x64xf16, #shared, #smem, mutable>, !ttg.memdesc<4x128x64xf16, #shared, #smem, mutable>, !ttg.memdesc<8xi64, #shared1, #smem, mutable>, !ttg.memdesc<4xi64, #shared1, #smem, mutable>, !ttg.memdesc<8xi64, #shared1, #smem, mutable>, !ttg.memdesc<4xi64, #shared1, #smem, mutable>, !tt.ptr<f16>, !ttg.memdesc<2x128x64xf16, #shared, #smem, mutable>, !tt.tensordesc<128x64xf16, #shared>) -> ()
    tt.return
  }
}
