module {
  tt.func public @_small_k_kernel(%a_desc: !tt.tensordesc<128x32xf16>, %a_desc.shape.0: i32, %a_desc.shape.1: i32, %a_desc.stride.0: i64, %a_desc.stride.1: i64, %b_desc: !tt.tensordesc<128x32xf16>, %b_desc.shape.0: i32, %b_desc.shape.1: i32, %b_desc.stride.0: i64, %b_desc.stride.1: i64, %c_desc: !tt.tensordesc<128x128xf16>, %c_desc.shape.0: i32, %c_desc.shape.1: i32, %c_desc.stride.0: i64, %c_desc.stride.1: i64, %workspace_desc: !tt.tensordesc<128x128xf16>, %workspace_desc.shape.0: i32, %workspace_desc.shape.1: i32, %workspace_desc.stride.0: i64, %workspace_desc.stride.1: i64, %bias_ptr: !tt.ptr<f16> {tt.divisibility = 16 : i32}, %M: i32, %N: i32 {tt.divisibility = 16 : i32}, %K: i32 {tt.divisibility = 16 : i32}) attributes {noinline = false} {
    %acc = arith.constant dense<0.000000e+00> : tensor<128x128xf32>
    %bias_vec = arith.constant dense<0.000000e+00> : tensor<128xf16>
    %k_tiles = arith.constant 31 : i32
    %c0_i32 = arith.constant 0 : i32
    %c127_i32 = arith.constant 127 : i32
    %c1_i32 = arith.constant 1 : i32
    %c32_i32 = arith.constant 32 : i32
    %c128_i32 = arith.constant 128 : i32
    %c8_i32 = arith.constant 8 : i32
    %pid = tt.get_program_id x : i32
    %num_pid_m = arith.addi %M, %c127_i32 : i32
    %num_pid_m_0 = arith.divsi %num_pid_m, %c128_i32 : i32
    %num_pid_n = arith.addi %N, %c127_i32 : i32
    %num_pid_n_1 = arith.divsi %num_pid_n, %c128_i32 : i32
    %num_pid_in_group = arith.muli %num_pid_n_1, %c8_i32 : i32
    %first_pid_m = arith.divsi %pid, %num_pid_in_group : i32
    %first_pid_m_2 = arith.muli %first_pid_m, %c8_i32 : i32
    %group_size_m = arith.subi %num_pid_m_0, %first_pid_m_2 : i32
    %group_size_m_3 = arith.minsi %group_size_m, %c8_i32 : i32
    %pid_m = arith.remsi %pid, %num_pid_in_group : i32
    %pid_m_4 = arith.remsi %pid_m, %group_size_m_3 : i32
    %pid_m_5 = arith.addi %first_pid_m_2, %pid_m_4 : i32
    %pid_n = arith.divsi %pid_m, %group_size_m_3 : i32
    %offs_m = arith.muli %pid_m_5, %c128_i32 : i32
    %offs_n = arith.muli %pid_n, %c128_i32 : i32
    %k_tiles_6 = arith.addi %K, %k_tiles : i32
    %k_tiles_7 = arith.divsi %k_tiles_6, %c32_i32 : i32
    %idx = tt.make_range {end = 128 : i32, start = 0 : i32} : tensor<128xi32>
    %idx_8 = tt.splat %offs_n : i32 -> tensor<128xi32>
    %idx_9 = arith.addi %idx_8, %idx : tensor<128xi32>
    %bias_vec_10 = tt.splat %N : i32 -> tensor<128xi32>
    %bias_vec_11 = arith.cmpi slt, %idx_9, %bias_vec_10 : tensor<128xi32>
    %bias_vec_12 = tt.splat %bias_ptr : !tt.ptr<f16> -> tensor<128x!tt.ptr<f16>>
    %bias_vec_13 = tt.addptr %bias_vec_12, %idx_9 : tensor<128x!tt.ptr<f16>>, tensor<128xi32>
    %bias_vec_14 = tt.load %bias_vec_13, %bias_vec_11, %bias_vec : tensor<128x!tt.ptr<f16>>
    %bias_vec_15 = arith.extf %bias_vec_14 : tensor<128xf16> to tensor<128xf32>
    %acc_16 = scf.for %k = %c0_i32 to %k_tiles_7 step %c1_i32 iter_args(%acc_20 = %acc) -> (tensor<128x128xf32>)  : i32 {
      %offs_k = arith.muli %k, %c32_i32 : i32
      %a = tt.descriptor_load %a_desc[%offs_m, %offs_k] : !tt.tensordesc<128x32xf16> -> tensor<128x32xf16>
      %b = tt.descriptor_load %b_desc[%offs_n, %offs_k] : !tt.tensordesc<128x32xf16> -> tensor<128x32xf16>
      %b_21 = tt.trans %b {order = array<i32: 1, 0>} : tensor<128x32xf16> -> tensor<32x128xf16>
      %acc_22 = tt.dot %a, %b_21, %acc_20, inputPrecision = tf32 : tensor<128x32xf16> * tensor<32x128xf16> -> tensor<128x128xf32>
      scf.yield %acc_22 : tensor<128x128xf32>
    }
    %acc_17 = tt.expand_dims %bias_vec_15 {axis = 0 : i32} : tensor<128xf32> -> tensor<1x128xf32>
    %acc_18 = tt.broadcast %acc_17 : tensor<1x128xf32> -> tensor<128x128xf32>
    %acc_19 = arith.addf %acc_16, %acc_18 : tensor<128x128xf32>
    %0 = arith.truncf %acc_19 : tensor<128x128xf32> to tensor<128x128xf16>
    tt.descriptor_store %c_desc[%offs_m, %offs_n], %0 : !tt.tensordesc<128x128xf16>, tensor<128x128xf16>
    tt.return
  }
}
