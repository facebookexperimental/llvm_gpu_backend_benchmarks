module {
  tt.func public @_small_k_kernel(%a_desc: !tt.tensordesc<64x64xbf16>, %a_desc.shape.0: i32, %a_desc.shape.1: i32, %a_desc.stride.0: i64, %a_desc.stride.1: i64, %b_desc: !tt.tensordesc<64x64xbf16>, %b_desc.shape.0: i32, %b_desc.shape.1: i32, %b_desc.stride.0: i64, %b_desc.stride.1: i64, %c_desc: !tt.tensordesc<64x64xbf16>, %c_desc.shape.0: i32, %c_desc.shape.1: i32, %c_desc.stride.0: i64, %c_desc.stride.1: i64, %workspace_desc: !tt.tensordesc<64x64xbf16>, %workspace_desc.shape.0: i32, %workspace_desc.shape.1: i32, %workspace_desc.stride.0: i64, %workspace_desc.stride.1: i64, %bias_ptr: !tt.ptr<bf16> {tt.divisibility = 16 : i32}, %M: i32 {tt.divisibility = 16 : i32}, %N: i32 {tt.divisibility = 16 : i32}, %K: i32 {tt.divisibility = 16 : i32}) attributes {noinline = false} {
    %acc = arith.constant dense<0.000000e+00> : tensor<64x64xf32>
    %bias_vec = arith.constant dense<0.000000e+00> : tensor<64xbf16>
    %c0_i32 = arith.constant 0 : i32
    %c63_i32 = arith.constant 63 : i32
    %c1_i32 = arith.constant 1 : i32
    %c64_i32 = arith.constant 64 : i32
    %c8_i32 = arith.constant 8 : i32
    %pid = tt.get_program_id x : i32
    %num_pid_m = arith.addi %M, %c63_i32 : i32
    %num_pid_m_0 = arith.divsi %num_pid_m, %c64_i32 : i32
    %num_pid_n = arith.addi %N, %c63_i32 : i32
    %num_pid_n_1 = arith.divsi %num_pid_n, %c64_i32 : i32
    %num_pid_in_group = arith.muli %num_pid_n_1, %c8_i32 : i32
    %first_pid_m = arith.divsi %pid, %num_pid_in_group : i32
    %first_pid_m_2 = arith.muli %first_pid_m, %c8_i32 : i32
    %group_size_m = arith.subi %num_pid_m_0, %first_pid_m_2 : i32
    %group_size_m_3 = arith.minsi %group_size_m, %c8_i32 : i32
    %pid_m = arith.remsi %pid, %num_pid_in_group : i32
    %pid_m_4 = arith.remsi %pid_m, %group_size_m_3 : i32
    %pid_m_5 = arith.addi %first_pid_m_2, %pid_m_4 : i32
    %pid_n = arith.divsi %pid_m, %group_size_m_3 : i32
    %offs_m = arith.muli %pid_m_5, %c64_i32 : i32
    %offs_n = arith.muli %pid_n, %c64_i32 : i32
    %k_tiles = arith.addi %K, %c63_i32 : i32
    %k_tiles_6 = arith.divsi %k_tiles, %c64_i32 : i32
    %idx = tt.make_range {end = 64 : i32, start = 0 : i32} : tensor<64xi32>
    %idx_7 = tt.splat %offs_n : i32 -> tensor<64xi32>
    %idx_8 = arith.addi %idx_7, %idx : tensor<64xi32>
    %bias_vec_9 = tt.splat %N : i32 -> tensor<64xi32>
    %bias_vec_10 = arith.cmpi slt, %idx_8, %bias_vec_9 : tensor<64xi32>
    %bias_vec_11 = tt.splat %bias_ptr : !tt.ptr<bf16> -> tensor<64x!tt.ptr<bf16>>
    %bias_vec_12 = tt.addptr %bias_vec_11, %idx_8 : tensor<64x!tt.ptr<bf16>>, tensor<64xi32>
    %bias_vec_13 = tt.load %bias_vec_12, %bias_vec_10, %bias_vec : tensor<64x!tt.ptr<bf16>>
    %bias_vec_14 = arith.extf %bias_vec_13 : tensor<64xbf16> to tensor<64xf32>
    %acc_15 = scf.for %k = %c0_i32 to %k_tiles_6 step %c1_i32 iter_args(%acc_19 = %acc) -> (tensor<64x64xf32>)  : i32 {
      %offs_k = arith.muli %k, %c64_i32 : i32
      %a = tt.descriptor_load %a_desc[%offs_m, %offs_k] : !tt.tensordesc<64x64xbf16> -> tensor<64x64xbf16>
      %b = tt.descriptor_load %b_desc[%offs_n, %offs_k] : !tt.tensordesc<64x64xbf16> -> tensor<64x64xbf16>
      %b_20 = tt.trans %b {order = array<i32: 1, 0>} : tensor<64x64xbf16> -> tensor<64x64xbf16>
      %acc_21 = tt.dot %a, %b_20, %acc_19, inputPrecision = tf32 : tensor<64x64xbf16> * tensor<64x64xbf16> -> tensor<64x64xf32>
      scf.yield %acc_21 : tensor<64x64xf32>
    }
    %acc_16 = tt.expand_dims %bias_vec_14 {axis = 0 : i32} : tensor<64xf32> -> tensor<1x64xf32>
    %acc_17 = tt.broadcast %acc_16 : tensor<1x64xf32> -> tensor<64x64xf32>
    %acc_18 = arith.addf %acc_15, %acc_17 : tensor<64x64xf32>
    %0 = arith.truncf %acc_18 : tensor<64x64xf32> to tensor<64x64xbf16>
    tt.descriptor_store %c_desc[%offs_m, %offs_n], %0 : !tt.tensordesc<64x64xbf16>, tensor<64x64xbf16>
    tt.return
  }
}
