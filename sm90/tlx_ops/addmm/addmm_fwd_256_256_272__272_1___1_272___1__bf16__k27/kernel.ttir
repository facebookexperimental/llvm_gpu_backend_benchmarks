module {
  tt.func public @_small_k_kernel(%a_desc: !tt.tensordesc<64x128xbf16>, %a_desc.shape.0: i32, %a_desc.shape.1: i32, %a_desc.stride.0: i64, %a_desc.stride.1: i64, %b_desc: !tt.tensordesc<16x128xbf16>, %b_desc.shape.0: i32, %b_desc.shape.1: i32, %b_desc.stride.0: i64, %b_desc.stride.1: i64, %c_desc: !tt.tensordesc<64x16xbf16>, %c_desc.shape.0: i32, %c_desc.shape.1: i32, %c_desc.stride.0: i64, %c_desc.stride.1: i64, %workspace_desc: !tt.tensordesc<64x16xbf16>, %workspace_desc.shape.0: i32, %workspace_desc.shape.1: i32, %workspace_desc.stride.0: i64, %workspace_desc.stride.1: i64, %bias_ptr: !tt.ptr<bf16> {tt.divisibility = 16 : i32}, %M: i32 {tt.divisibility = 16 : i32}, %N: i32 {tt.divisibility = 16 : i32}, %K: i32 {tt.divisibility = 16 : i32}) attributes {noinline = false} {
    %acc = arith.constant dense<0.000000e+00> : tensor<64x16xf32>
    %bias_vec = arith.constant dense<0.000000e+00> : tensor<16xbf16>
    %k_tiles = arith.constant 127 : i32
    %c0_i32 = arith.constant 0 : i32
    %num_pid_n = arith.constant 15 : i32
    %num_pid_m = arith.constant 63 : i32
    %c1_i32 = arith.constant 1 : i32
    %c128_i32 = arith.constant 128 : i32
    %c16_i32 = arith.constant 16 : i32
    %c64_i32 = arith.constant 64 : i32
    %c8_i32 = arith.constant 8 : i32
    %pid = tt.get_program_id x : i32
    %num_pid_m_0 = arith.addi %M, %num_pid_m : i32
    %num_pid_m_1 = arith.divsi %num_pid_m_0, %c64_i32 : i32
    %num_pid_n_2 = arith.addi %N, %num_pid_n : i32
    %num_pid_n_3 = arith.divsi %num_pid_n_2, %c16_i32 : i32
    %num_pid_in_group = arith.muli %num_pid_n_3, %c8_i32 : i32
    %first_pid_m = arith.divsi %pid, %num_pid_in_group : i32
    %first_pid_m_4 = arith.muli %first_pid_m, %c8_i32 : i32
    %group_size_m = arith.subi %num_pid_m_1, %first_pid_m_4 : i32
    %group_size_m_5 = arith.minsi %group_size_m, %c8_i32 : i32
    %pid_m = arith.remsi %pid, %num_pid_in_group : i32
    %pid_m_6 = arith.remsi %pid_m, %group_size_m_5 : i32
    %pid_m_7 = arith.addi %first_pid_m_4, %pid_m_6 : i32
    %pid_n = arith.divsi %pid_m, %group_size_m_5 : i32
    %offs_m = arith.muli %pid_m_7, %c64_i32 : i32
    %offs_n = arith.muli %pid_n, %c16_i32 : i32
    %k_tiles_8 = arith.addi %K, %k_tiles : i32
    %k_tiles_9 = arith.divsi %k_tiles_8, %c128_i32 : i32
    %idx = tt.make_range {end = 16 : i32, start = 0 : i32} : tensor<16xi32>
    %idx_10 = tt.splat %offs_n : i32 -> tensor<16xi32>
    %idx_11 = arith.addi %idx_10, %idx : tensor<16xi32>
    %bias_vec_12 = tt.splat %N : i32 -> tensor<16xi32>
    %bias_vec_13 = arith.cmpi slt, %idx_11, %bias_vec_12 : tensor<16xi32>
    %bias_vec_14 = tt.splat %bias_ptr : !tt.ptr<bf16> -> tensor<16x!tt.ptr<bf16>>
    %bias_vec_15 = tt.addptr %bias_vec_14, %idx_11 : tensor<16x!tt.ptr<bf16>>, tensor<16xi32>
    %bias_vec_16 = tt.load %bias_vec_15, %bias_vec_13, %bias_vec : tensor<16x!tt.ptr<bf16>>
    %bias_vec_17 = arith.extf %bias_vec_16 : tensor<16xbf16> to tensor<16xf32>
    %acc_18 = scf.for %k = %c0_i32 to %k_tiles_9 step %c1_i32 iter_args(%acc_22 = %acc) -> (tensor<64x16xf32>)  : i32 {
      %offs_k = arith.muli %k, %c128_i32 : i32
      %a = tt.descriptor_load %a_desc[%offs_m, %offs_k] : !tt.tensordesc<64x128xbf16> -> tensor<64x128xbf16>
      %b = tt.descriptor_load %b_desc[%offs_n, %offs_k] : !tt.tensordesc<16x128xbf16> -> tensor<16x128xbf16>
      %b_23 = tt.trans %b {order = array<i32: 1, 0>} : tensor<16x128xbf16> -> tensor<128x16xbf16>
      %acc_24 = tt.dot %a, %b_23, %acc_22, inputPrecision = tf32 : tensor<64x128xbf16> * tensor<128x16xbf16> -> tensor<64x16xf32>
      scf.yield %acc_24 : tensor<64x16xf32>
    }
    %acc_19 = tt.expand_dims %bias_vec_17 {axis = 0 : i32} : tensor<16xf32> -> tensor<1x16xf32>
    %acc_20 = tt.broadcast %acc_19 : tensor<1x16xf32> -> tensor<64x16xf32>
    %acc_21 = arith.addf %acc_18, %acc_20 : tensor<64x16xf32>
    %0 = arith.truncf %acc_21 : tensor<64x16xf32> to tensor<64x16xbf16>
    tt.descriptor_store %c_desc[%offs_m, %offs_n], %0 : !tt.tensordesc<64x16xbf16>, tensor<64x16xbf16>
    tt.return
  }
}
