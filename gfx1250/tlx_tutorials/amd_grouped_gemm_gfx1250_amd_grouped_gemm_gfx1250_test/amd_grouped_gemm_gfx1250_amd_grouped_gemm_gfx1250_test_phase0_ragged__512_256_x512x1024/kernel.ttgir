        tt.store %c_ptrs_91, %c, %5 : tensor<64x64x!tt.ptr<f16>, #mma>
        %tile_idx_92 = arith.addi %tile_idx_19, %c96_i32 : i32
        scf.yield %tile_idx_92 : i32
      }
      scf.yield %tile_idx_18, %0 : i32, i32
    }
    tt.return
  }
}
