        ttg.local_store %c, %c_view : tensor<128x128xf16, #mma> -> !ttg.memdesc<128x128xf16, #shared, #smem, mutable>
        %8 = amdg.update_tensor_descriptor %c_desc add_offsets = [%c0_i32, %c0_i32] : !tt.tensordesc<128x128xf16, #shared>
        %9 = amdg.async_tdm_copy_local_to_global %8 from %c_view : !ttg.memdesc<128x128xf16, #shared, #smem, mutable> -> !tt.tensordesc<128x128xf16, #shared>
        %tile_idx_37 = arith.addi %tile_idx_27, %c24_i32 : i32
        scf.yield %tile_idx_37 : i32
      }
      scf.yield %tile_idx_26, %1 : i32, i32
    }
    tt.return
  }
}
