    %q_shifted_120 = tt.expand_dims %m_ij_119 {axis = 1 : i32} : tensor<32xf32, #ttg.slice<{dim = 1, parent = #mma}>> -> tensor<32x1xf32, #mma>
    %q_shifted_121 = tt.broadcast %q_shifted_120 : tensor<32x1xf32, #mma> -> tensor<32x128xf32, #mma>
    %q_shifted_122 = arith.subf %qk_106, %q_shifted_121 : tensor<32x128xf32, #mma>
    %q_shifted_123 = arith.mulf %q_shifted_122, %cst : tensor<32x128xf32, #mma>
    %p_124 = math.exp2 %q_shifted_123 : tensor<32x128xf32, #mma>
