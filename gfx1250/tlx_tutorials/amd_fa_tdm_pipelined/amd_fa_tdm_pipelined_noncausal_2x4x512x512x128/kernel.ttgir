    %alpha_126 = arith.mulf %alpha_125, %cst_0 : tensor<32xf32, #ttg.slice<{dim = 1, parent = #mma}>>
    %alpha_127 = math.exp2 %alpha_126 : tensor<32xf32, #ttg.slice<{dim = 1, parent = #mma}>>
    %l_ij_128 = "tt.reduce"(%p_124) <{axis = 1 : i32, reduction_ordering = "unordered"}> ({
    ^bb0(%l_ij_143: f32, %l_ij_144: f32):
