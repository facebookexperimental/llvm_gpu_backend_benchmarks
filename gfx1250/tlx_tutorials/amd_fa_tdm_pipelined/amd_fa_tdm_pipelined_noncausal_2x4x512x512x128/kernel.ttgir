    }) : (tensor<32x128xf32, #mma>) -> tensor<32xf32, #ttg.slice<{dim = 1, parent = #mma}>>
    %acc_129 = tt.expand_dims %alpha_127 {axis = 1 : i32} : tensor<32xf32, #ttg.slice<{dim = 1, parent = #mma}>> -> tensor<32x1xf32, #mma>
    %acc_130 = tt.broadcast %acc_129 : tensor<32x1xf32, #mma> -> tensor<32x128xf32, #mma>
    %acc_131 = arith.mulf %acc_117, %acc_130 : tensor<32x128xf32, #mma>
    %l_i_132 = arith.mulf %l_i_112, %alpha_127 : tensor<32xf32, #ttg.slice<{dim = 1, parent = #mma}>>
    %l_i_133 = arith.addf %l_i_132, %l_ij_128 : tensor<32xf32, #ttg.slice<{dim = 1, parent = #mma}>>
    %p_low_134 = arith.truncf %p_124 : tensor<32x128xf32, #mma> to tensor<32x128xbf16, #mma>
    %v_135 = amdg.async_tdm_wait  {num = 0 : i32}
    %value_136 = ttg.local_load %15 : !ttg.memdesc<128x128xbf16, #shared2, #smem, mutable> -> tensor<128x128xbf16, #ttg.dot_op<{opIdx = 1, parent = #mma, kWidth = 8}>>
    rocdl.sched.barrier none
    ttg.barrier local
    rocdl.sched.barrier none
    %p_low_137 = ttg.convert_layout %p_low_134 : tensor<32x128xbf16, #mma> -> tensor<32x128xbf16, #ttg.dot_op<{opIdx = 0, parent = #mma, kWidth = 8}>>
    %acc_138 = tt.dot %p_low_137, %value_136, %acc_131 : tensor<32x128xbf16, #ttg.dot_op<{opIdx = 0, parent = #mma, kWidth = 8}>> * tensor<128x128xbf16, #ttg.dot_op<{opIdx = 1, parent = #mma, kWidth = 8}>> -> tensor<32x128xf32, #mma>
    %l_recip_139 = tt.expand_dims %l_i_133 {axis = 1 : i32} : tensor<32xf32, #ttg.slice<{dim = 1, parent = #mma}>> -> tensor<32x1xf32, #mma>
    %l_recip_140 = arith.divf %l_recip, %l_recip_139 : tensor<32x1xf32, #mma>
    %acc_141 = tt.broadcast %l_recip_140 : tensor<32x1xf32, #mma> -> tensor<32x128xf32, #mma>
    %acc_142 = arith.mulf %acc_138, %acc_141 : tensor<32x128xf32, #mma>
    %o_view = ttg.memdesc_index %o_buf[%c0_i32] : !ttg.memdesc<1x32x128xf32, #shared3, #smem, mutable> -> !ttg.memdesc<32x128xf32, #shared3, #smem, mutable>
    ttg.local_store %acc_142, %o_view : tensor<32x128xf32, #mma> -> !ttg.memdesc<32x128xf32, #shared3, #smem, mutable>
    %24 = amdg.update_tensor_descriptor %o_desc_37 add_offsets = [%off_m_8, %c0_i32] {clamp_bounds} : !tt.tensordesc<32x128xf32, #shared3>
    %25 = amdg.async_tdm_copy_local_to_global %24 from %o_view : !ttg.memdesc<32x128xf32, #shared3, #smem, mutable> -> !tt.tensordesc<32x128xf32, #shared3>
    %26 = amdg.async_tdm_wait  {num = 0 : i32}
