        %130 = amdg.async_tdm_wait  {num = 1 : i32}
        ttg.local_store %outRHS_314, %view_293 : tensor<64x128xbf16, #tlx.no_verify_layout<#linear4>> -> !ttg.memdesc<64x128xbf16, #shared2, #smem, mutable>
        %131 = amdg.update_tensor_descriptor %desc_312 add_offsets = [%c64_i32, %c0_i32] : !tt.tensordesc<64x128xbf16>
        %132 = amdg.async_tdm_copy_local_to_global %131 from %view_293 : !ttg.memdesc<64x128xbf16, #shared2, #smem, mutable> -> !tt.tensordesc<64x128xbf16>
        scf.yield %acc, %acc_294, %c10_285, %c11_287 : tensor<128x128xf32, #tlx.no_verify_layout<#shared14>>, tensor<128x128xf32, #tlx.no_verify_layout<#shared14>>, tensor<128x128xf32, #tlx.no_verify_layout<#shared14>>, tensor<128x128xf32, #tlx.no_verify_layout<#shared14>>
