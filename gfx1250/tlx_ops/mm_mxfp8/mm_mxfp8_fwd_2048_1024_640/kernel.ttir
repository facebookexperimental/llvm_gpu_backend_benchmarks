      rocdl.sched.barrier none
      scf.yield %n_phase_288, %100#0, %100#1, %100#2, %100#3 : i32, tensor<128x128xf32, #tlx.no_verify_layout<#shared14>>, tensor<128x128xf32, #tlx.no_verify_layout<#shared14>>, tensor<128x128xf32, #tlx.no_verify_layout<#shared14>>, tensor<128x128xf32, #tlx.no_verify_layout<#shared14>>
    }
    %64 = amdg.async_tdm_wait  {num = 0 : i32}
    %65 = amdg.async_tdm_wait  {num = 0 : i32}
