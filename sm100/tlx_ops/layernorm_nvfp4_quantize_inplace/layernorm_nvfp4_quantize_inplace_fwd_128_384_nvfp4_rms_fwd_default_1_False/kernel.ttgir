    %20 = arith.trunci %packed : tensor<4x256xi32, #blocked6> to tensor<4x256xi8, #blocked6>
    %21 = arith.muli %cols2, %cst_7 : tensor<256xi32, #ttg.slice<{dim = 0, parent = #blocked3}>>
    %22 = arith.cmpi slt, %21, %cst_8 : tensor<256xi32, #ttg.slice<{dim = 0, parent = #blocked3}>>
    %23 = tt.expand_dims %22 {axis = 0 : i32} : tensor<256xi1, #ttg.slice<{dim = 0, parent = #blocked3}>> -> tensor<1x256xi1, #blocked3>
    %24 = tt.broadcast %mask_40 : tensor<4x1xi1, #blocked3> -> tensor<4x256xi1, #blocked3>
    %25 = tt.broadcast %23 : tensor<1x256xi1, #blocked3> -> tensor<4x256xi1, #blocked3>
    %26 = arith.andi %24, %25 : tensor<4x256xi1, #blocked3>
    %27 = ttg.convert_layout %20 : tensor<4x256xi8, #blocked6> -> tensor<4x256xi8, #blocked3>
    tt.store %19, %27, %26 : tensor<4x256x!tt.ptr<i8>, #blocked3>
    tt.return
  }
}
