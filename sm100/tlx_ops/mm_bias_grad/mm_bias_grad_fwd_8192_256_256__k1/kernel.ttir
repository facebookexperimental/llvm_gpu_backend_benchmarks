module {
  tt.func public @_reduce_k_and_bias_kernel(%workspace_ptr: !tt.ptr<bf16> {tt.divisibility = 16 : i32}, %c_ptr: !tt.ptr<bf16> {tt.divisibility = 16 : i32}, %bias_workspace_ptr: !tt.ptr<bf16> {tt.divisibility = 16 : i32}, %bias_out_ptr: !tt.ptr<bf16> {tt.divisibility = 16 : i32}, %M: i32 {tt.divisibility = 16 : i32}, %N: i32 {tt.divisibility = 16 : i32}) attributes {noinline = false} {
    %cst = arith.constant dense<0.000000e+00> : tensor<32xf32>
    %cst_0 = arith.constant dense<0.000000e+00> : tensor<32x32xf32>
    %num_n_tiles = arith.constant 31 : i32
    %cst_1 = arith.constant dense<0.000000e+00> : tensor<32xbf16>
    %cst_2 = arith.constant dense<0.000000e+00> : tensor<32x32xbf16>
    %c1_i32 = arith.constant 1 : i32
    %c0_i32 = arith.constant 0 : i32
    %c32_i32 = arith.constant 32 : i32
    %pid_m = tt.get_program_id x : i32
    %pid_n = tt.get_program_id y : i32
    %offs_m = arith.muli %pid_m, %c32_i32 : i32
    %offs_m_3 = tt.make_range {end = 32 : i32, start = 0 : i32} : tensor<32xi32>
    %offs_m_4 = tt.splat %offs_m : i32 -> tensor<32xi32>
    %offs_m_5 = arith.addi %offs_m_4, %offs_m_3 : tensor<32xi32>
    %num_n_tiles_6 = arith.addi %N, %num_n_tiles : i32
    %num_n_tiles_7 = arith.divsi %num_n_tiles_6, %c32_i32 : i32
    %0 = arith.cmpi slt, %pid_n, %num_n_tiles_7 : i32
    scf.if %0 {
      %offs_n = arith.muli %pid_n, %c32_i32 : i32
      %offs_n_8 = tt.splat %offs_n : i32 -> tensor<32xi32>
      %offs_n_9 = arith.addi %offs_n_8, %offs_m_3 : tensor<32xi32>
      %mask = tt.expand_dims %offs_m_5 {axis = 1 : i32} : tensor<32xi32> -> tensor<32x1xi32>
      %mask_10 = tt.splat %M : i32 -> tensor<32x1xi32>
      %mask_11 = arith.cmpi slt, %mask, %mask_10 : tensor<32x1xi32>
      %mask_12 = tt.expand_dims %offs_n_9 {axis = 0 : i32} : tensor<32xi32> -> tensor<1x32xi32>
      %mask_13 = tt.splat %N : i32 -> tensor<1x32xi32>
      %mask_14 = arith.cmpi slt, %mask_12, %mask_13 : tensor<1x32xi32>
      %mask_15 = tt.broadcast %mask_11 : tensor<32x1xi1> -> tensor<32x32xi1>
      %mask_16 = tt.broadcast %mask_14 : tensor<1x32xi1> -> tensor<32x32xi1>
      %mask_17 = arith.andi %mask_15, %mask_16 : tensor<32x32xi1>
      %base_offs = tt.splat %N : i32 -> tensor<32x1xi32>
      %base_offs_18 = arith.muli %mask, %base_offs : tensor<32x1xi32>
      %base_offs_19 = tt.broadcast %base_offs_18 : tensor<32x1xi32> -> tensor<32x32xi32>
      %base_offs_20 = tt.broadcast %mask_12 : tensor<1x32xi32> -> tensor<32x32xi32>
      %base_offs_21 = arith.addi %base_offs_19, %base_offs_20 : tensor<32x32xi32>
      %partial = tt.splat %workspace_ptr : !tt.ptr<bf16> -> tensor<32x32x!tt.ptr<bf16>>
      %acc = scf.for %s = %c0_i32 to %c32_i32 step %c1_i32 iter_args(%acc_22 = %cst_0) -> (tensor<32x32xf32>)  : i32 {
        %ws_offs = arith.muli %s, %M : i32
        %ws_offs_23 = arith.muli %ws_offs, %N : i32
        %ws_offs_24 = tt.splat %ws_offs_23 : i32 -> tensor<32x32xi32>
        %ws_offs_25 = arith.addi %base_offs_21, %ws_offs_24 : tensor<32x32xi32>
        %partial_26 = tt.addptr %partial, %ws_offs_25 : tensor<32x32x!tt.ptr<bf16>>, tensor<32x32xi32>
        %partial_27 = tt.load %partial_26, %mask_17, %cst_2 : tensor<32x32x!tt.ptr<bf16>>
        %acc_28 = arith.extf %partial_27 : tensor<32x32xbf16> to tensor<32x32xf32>
        %acc_29 = arith.addf %acc_22, %acc_28 : tensor<32x32xf32>
        scf.yield %acc_29 : tensor<32x32xf32>
      }
      %1 = tt.splat %c_ptr : !tt.ptr<bf16> -> tensor<32x32x!tt.ptr<bf16>>
      %2 = tt.addptr %1, %base_offs_21 : tensor<32x32x!tt.ptr<bf16>>, tensor<32x32xi32>
      %3 = arith.truncf %acc : tensor<32x32xf32> to tensor<32x32xbf16>
      tt.store %2, %3, %mask_17 : tensor<32x32x!tt.ptr<bf16>>
    } else {
      %m_mask = tt.splat %M : i32 -> tensor<32xi32>
      %m_mask_8 = arith.cmpi slt, %offs_m_5, %m_mask : tensor<32xi32>
      %bias_acc = scf.for %s = %c0_i32 to %c32_i32 step %c1_i32 iter_args(%bias_acc_9 = %cst) -> (tensor<32xf32>)  : i32 {
        %bp = arith.muli %s, %M : i32
        %bp_10 = tt.addptr %bias_workspace_ptr, %bp : !tt.ptr<bf16>, i32
        %bp_11 = tt.splat %bp_10 : !tt.ptr<bf16> -> tensor<32x!tt.ptr<bf16>>
        %bp_12 = tt.addptr %bp_11, %offs_m_5 : tensor<32x!tt.ptr<bf16>>, tensor<32xi32>
        %bp_13 = tt.load %bp_12, %m_mask_8, %cst_1 : tensor<32x!tt.ptr<bf16>>
        %bias_acc_14 = arith.extf %bp_13 : tensor<32xbf16> to tensor<32xf32>
        %bias_acc_15 = arith.addf %bias_acc_9, %bias_acc_14 : tensor<32xf32>
        scf.yield %bias_acc_15 : tensor<32xf32>
      }
      %1 = tt.splat %bias_out_ptr : !tt.ptr<bf16> -> tensor<32x!tt.ptr<bf16>>
      %2 = tt.addptr %1, %offs_m_5 : tensor<32x!tt.ptr<bf16>>, tensor<32xi32>
      %3 = arith.truncf %bias_acc : tensor<32xf32> to tensor<32xbf16>
      tt.store %2, %3, %m_mask_8 : tensor<32x!tt.ptr<bf16>>
    }
    tt.return
  }
}
