    %cst_0 = arith.constant dense<2> : tensor<128x1xi32, #blocked>
    %cst_1 = arith.constant dense<64> : tensor<128x1xi32, #blocked>
    %off_m = tt.get_program_id x : i32
    %off_m_2 = arith.muli %off_m, %c128_i32 : i32
    %off_m_3 = tt.make_range {end = 128 : i32, start = 0 : i32} : tensor<128xi32, #ttg.slice<{dim = 1, parent = #blocked}>>
    %off_m_4 = tt.splat %off_m_2 : i32 -> tensor<128xi32, #ttg.slice<{dim = 1, parent = #blocked}>>
    %off_m_5 = arith.addi %off_m_4, %off_m_3 : tensor<128xi32, #ttg.slice<{dim = 1, parent = #blocked}>>
    %off_hz = tt.get_program_id y : i32
    %q = tt.expand_dims %off_m_5 {axis = 1 : i32} : tensor<128xi32, #ttg.slice<{dim = 1, parent = #blocked}>> -> tensor<128x1xi32, #blocked>
    %tile_base = arith.divsi %q, %cst_1 : tensor<128x1xi32, #blocked>
    %tile_base_6 = arith.muli %tile_base, %cst_1 : tensor<128x1xi32, #blocked>
    %local = arith.remsi %q, %cst_1 : tensor<128x1xi32, #blocked>
    %h = tt.make_range {end = 64 : i32, start = 0 : i32} : tensor<64xi32, #ttg.slice<{dim = 0, parent = #blocked}>>
    %h_7 = tt.expand_dims %h {axis = 0 : i32} : tensor<64xi32, #ttg.slice<{dim = 0, parent = #blocked}>> -> tensor<1x64xi32, #blocked>
    %packed_row = arith.muli %tile_base_6, %cst_0 : tensor<128x1xi32, #blocked>
    %packed_row_8 = arith.addi %packed_row, %local : tensor<128x1xi32, #blocked>
    %src = arith.muli %off_hz, %N_CTX : i32
    %src_9 = arith.muli %src, %c128_i32 : i32
    %src_10 = tt.addptr %DQ_ACCUM, %src_9 : !tt.ptr<f32>, i32
    %src_11 = tt.splat %src_10 : !tt.ptr<f32> -> tensor<128x1x!tt.ptr<f32>, #blocked>
    %src_12 = tt.broadcast %h_7 : tensor<1x64xi32, #blocked> -> tensor<128x64xi32, #blocked>
    %dst = tt.addptr %DQ_OUT, %src_9 : !tt.ptr<f16>, i32
    %dst_13 = arith.muli %q, %cst : tensor<128x1xi32, #blocked>
    %dst_14 = tt.splat %dst : !tt.ptr<f16> -> tensor<128x1x!tt.ptr<f16>, #blocked>
    %dst_15 = tt.addptr %dst_14, %dst_13 : tensor<128x1x!tt.ptr<f16>, #blocked>, tensor<128x1xi32, #blocked>
    %dst_16 = tt.broadcast %dst_15 : tensor<128x1x!tt.ptr<f16>, #blocked> -> tensor<128x64x!tt.ptr<f16>, #blocked>
    scf.for %half = %c0_i32 to %c2_i32 step %c1_i32  : i32 {
      %h_17 = arith.muli %half, %c64_i32 : i32
      %h_18 = tt.splat %h_17 : i32 -> tensor<1x64xi32, #blocked>
      %h_19 = arith.addi %h_7, %h_18 : tensor<1x64xi32, #blocked>
      %packed_row_20 = tt.splat %h_17 : i32 -> tensor<128x1xi32, #blocked>
      %packed_row_21 = arith.addi %packed_row_8, %packed_row_20 : tensor<128x1xi32, #blocked>
      %src_22 = arith.muli %packed_row_21, %cst_1 : tensor<128x1xi32, #blocked>
      %src_23 = tt.addptr %src_11, %src_22 : tensor<128x1x!tt.ptr<f32>, #blocked>, tensor<128x1xi32, #blocked>
      %src_24 = tt.broadcast %src_23 : tensor<128x1x!tt.ptr<f32>, #blocked> -> tensor<128x64x!tt.ptr<f32>, #blocked>
      %src_25 = tt.addptr %src_24, %src_12 : tensor<128x64x!tt.ptr<f32>, #blocked>, tensor<128x64xi32, #blocked>
      %val = tt.load %src_25 : tensor<128x64x!tt.ptr<f32>, #blocked>
      %dst_26 = tt.broadcast %h_19 : tensor<1x64xi32, #blocked> -> tensor<128x64xi32, #blocked>
      %dst_27 = tt.addptr %dst_16, %dst_26 : tensor<128x64x!tt.ptr<f16>, #blocked>, tensor<128x64xi32, #blocked>
      %0 = arith.truncf %val : tensor<128x64xf32, #blocked> to tensor<128x64xf16, #blocked>
      tt.store %dst_27, %0 : tensor<128x64x!tt.ptr<f16>, #blocked>
