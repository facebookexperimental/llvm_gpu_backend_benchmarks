module {
  tt.func public @_reduce_splits_kernel(%P: !tt.ptr<f32> {tt.divisibility = 16 : i32}, %OUT: !tt.ptr<f32> {tt.divisibility = 16 : i32}, %MN: i32 {tt.divisibility = 16 : i32}) attributes {noinline = false} {
    %acc = arith.constant 3 : i32
    %acc_0 = arith.constant 2 : i32
    %cst = arith.constant dense<0.000000e+00> : tensor<1024xf32>
    %offs = arith.constant 1024 : i32
    %pid = tt.get_program_id x : i32
    %offs_1 = arith.muli %pid, %offs : i32
    %offs_2 = tt.make_range {end = 1024 : i32, start = 0 : i32} : tensor<1024xi32>
    %offs_3 = tt.splat %offs_1 : i32 -> tensor<1024xi32>
    %offs_4 = arith.addi %offs_3, %offs_2 : tensor<1024xi32>
    %mask = tt.splat %MN : i32 -> tensor<1024xi32>
    %mask_5 = arith.cmpi slt, %offs_4, %mask : tensor<1024xi32>
    %acc_6 = tt.splat %P : !tt.ptr<f32> -> tensor<1024x!tt.ptr<f32>>
    %acc_7 = tt.addptr %acc_6, %offs_4 : tensor<1024x!tt.ptr<f32>>, tensor<1024xi32>
    %acc_8 = tt.load %acc_7, %mask_5, %cst : tensor<1024x!tt.ptr<f32>>
    %acc_9 = tt.addptr %P, %MN : !tt.ptr<f32>, i32
    %acc_10 = tt.splat %acc_9 : !tt.ptr<f32> -> tensor<1024x!tt.ptr<f32>>
    %acc_11 = tt.addptr %acc_10, %offs_4 : tensor<1024x!tt.ptr<f32>>, tensor<1024xi32>
    %acc_12 = tt.load %acc_11, %mask_5, %cst : tensor<1024x!tt.ptr<f32>>
    %acc_13 = arith.addf %acc_8, %acc_12 : tensor<1024xf32>
    %acc_14 = arith.muli %MN, %acc_0 : i32
    %acc_15 = tt.addptr %P, %acc_14 : !tt.ptr<f32>, i32
    %acc_16 = tt.splat %acc_15 : !tt.ptr<f32> -> tensor<1024x!tt.ptr<f32>>
    %acc_17 = tt.addptr %acc_16, %offs_4 : tensor<1024x!tt.ptr<f32>>, tensor<1024xi32>
    %acc_18 = tt.load %acc_17, %mask_5, %cst : tensor<1024x!tt.ptr<f32>>
    %acc_19 = arith.addf %acc_13, %acc_18 : tensor<1024xf32>
    %acc_20 = arith.muli %MN, %acc : i32
    %acc_21 = tt.addptr %P, %acc_20 : !tt.ptr<f32>, i32
    %acc_22 = tt.splat %acc_21 : !tt.ptr<f32> -> tensor<1024x!tt.ptr<f32>>
    %acc_23 = tt.addptr %acc_22, %offs_4 : tensor<1024x!tt.ptr<f32>>, tensor<1024xi32>
    %acc_24 = tt.load %acc_23, %mask_5, %cst : tensor<1024x!tt.ptr<f32>>
    %acc_25 = arith.addf %acc_19, %acc_24 : tensor<1024xf32>
    %0 = tt.splat %OUT : !tt.ptr<f32> -> tensor<1024x!tt.ptr<f32>>
    %1 = tt.addptr %0, %offs_4 : tensor<1024x!tt.ptr<f32>>, tensor<1024xi32>
    tt.store %1, %acc_25, %mask_5 : tensor<1024x!tt.ptr<f32>>
    tt.return
  }
}
