    %11 = arith.addi %7, %9 : tensor<128x256xi32, #mma>
    %12 = tt.splat %10 : i32 -> tensor<128x256xi32, #mma>
    %13 = arith.addi %12, %11 : tensor<128x256xi32, #mma>
    %14 = arith.truncf %acc_86 : tensor<128x256xf32, #mma> to tensor<128x256xf16, #mma>
    amdg.buffer_store %14, %c_ptr[%13], %mask_91 : !tt.ptr<f16> -> tensor<128x256xf16, #mma>
    tt.return
  }
}
