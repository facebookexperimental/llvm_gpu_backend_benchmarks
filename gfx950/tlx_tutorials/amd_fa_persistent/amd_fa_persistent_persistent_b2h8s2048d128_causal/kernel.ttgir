          %18 = arith.cmpi slt, %q_43, %cst_2 : tensor<1x128xi32, #linear1>
          %19 = tt.broadcast %18 : tensor<1x128xi1, #linear1> -> tensor<256x128xi1, #linear1>
          %20 = arith.andi %q_54, %19 : tensor<256x128xi1, #linear1>
          %21 = arith.truncf %acc_89 : tensor<256x128xf32, #mma> to tensor<256x128xbf16, #mma>
          %22 = ttg.convert_layout %21 : tensor<256x128xbf16, #mma> -> tensor<256x128xbf16, #linear1>
          amdg.buffer_store %22, %Out[%o_ptrs_98], %20 {contiguity = 8 : i32} : !tt.ptr<bf16> -> tensor<256x128xbf16, #linear1>
        }
      }
    } {tt.num_stages = 1 : i32}
    tt.return
  }
}
