            %l_i_110 = arith.mulf %l_i, %alpha_106 : tensor<256xf32, #ttg.slice<{dim = 1, parent = #mma}>>
            %l_i_111 = arith.addf %l_i_110, %l_ij : tensor<256xf32, #ttg.slice<{dim = 1, parent = #mma}>>
