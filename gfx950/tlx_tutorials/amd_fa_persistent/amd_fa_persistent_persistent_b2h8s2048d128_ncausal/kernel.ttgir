            %acc_113 = ttg.convert_layout %acc_112 : tensor<256x64xbf16, #mma> -> tensor<256x64xbf16, #ttg.dot_op<{opIdx = 0, parent = #mma, kWidth = 4}>>
            %acc_114 = tt.dot %acc_113, %v_cur_87, %acc_109 : tensor<256x64xbf16, #ttg.dot_op<{opIdx = 0, parent = #mma, kWidth = 4}>> * tensor<64x128xbf16, #ttg.dot_op<{opIdx = 1, parent = #mma, kWidth = 4}>> -> tensor<256x128xf32, #mma>
            scf.yield %m_ij_101, %l_i_111, %acc_114 : tensor<256xf32, #ttg.slice<{dim = 1, parent = #mma}>>, tensor<256xf32, #ttg.slice<{dim = 1, parent = #mma}>>, tensor<256x128xf32, #mma>
          } {tt.num_stages = 1 : i32}
          %acc_72 = tt.expand_dims %acc#1 {axis = 1 : i32} : tensor<256xf32, #ttg.slice<{dim = 1, parent = #mma}>> -> tensor<256x1xf32, #mma>
          %acc_73 = tt.broadcast %acc_72 : tensor<256x1xf32, #mma> -> tensor<256x128xf32, #mma>
