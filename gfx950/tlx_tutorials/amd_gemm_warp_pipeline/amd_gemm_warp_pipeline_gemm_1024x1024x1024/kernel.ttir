    %c_mask = tt.splat %M : i32 -> tensor<256x1xi32>
    %c_mask_103 = arith.cmpi slt, %c_ptrs, %c_mask : tensor<256x1xi32>
    %c_mask_104 = tt.splat %N : i32 -> tensor<1x256xi32>
    %c_mask_105 = arith.cmpi slt, %c_ptrs_99, %c_mask_104 : tensor<1x256xi32>
    %c_mask_106 = tt.broadcast %c_mask_103 : tensor<256x1xi1> -> tensor<256x256xi1>
    %c_mask_107 = tt.broadcast %c_mask_105 : tensor<1x256xi1> -> tensor<256x256xi1>
    %c_mask_108 = arith.andi %c_mask_106, %c_mask_107 : tensor<256x256xi1>
    tt.store %c_ptrs_102, %c, %c_mask_108 : tensor<256x256x!tt.ptr<f16>>
    tt.return
  }
}
