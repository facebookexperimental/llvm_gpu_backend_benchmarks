    %c_mask_96 = arith.andi %c_mask_94, %c_mask_95 : tensor<256x256xi1, #mma>
    amdg.buffer_store %c, %c_ptr[%c_ptrs_90], %c_mask_96 {contiguity = 4 : i32} : !tt.ptr<f16> -> tensor<256x256xf16, #mma>
