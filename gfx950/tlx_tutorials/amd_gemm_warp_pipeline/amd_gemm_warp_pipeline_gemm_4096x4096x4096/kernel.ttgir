    %c_ptrs_85 = tt.expand_dims %offs_m_20 {axis = 0 : i32} : tensor<256xi32, #ttg.slice<{dim = 0, parent = #mma}>> -> tensor<1x256xi32, #mma>
    %c_ptrs_86 = tt.broadcast %c_ptrs_85 : tensor<1x256xi32, #mma> -> tensor<256x256xi32, #mma>
    %c_ptrs_87 = arith.addi %c_ptrs_79, %offs_n : i32
    %c_ptrs_88 = arith.addi %c_ptrs_84, %c_ptrs_86 : tensor<256x256xi32, #mma>
    %c_ptrs_89 = tt.splat %c_ptrs_87 : i32 -> tensor<256x256xi32, #mma>
    %c_ptrs_90 = arith.addi %c_ptrs_89, %c_ptrs_88 : tensor<256x256xi32, #mma>
    %c_mask = tt.splat %M : i32 -> tensor<256x1xi32, #mma>
    %c_mask_91 = arith.cmpi slt, %c_ptrs, %c_mask : tensor<256x1xi32, #mma>
    %c_mask_92 = tt.splat %N : i32 -> tensor<1x256xi32, #mma>
    %c_mask_93 = arith.cmpi slt, %c_ptrs_80, %c_mask_92 : tensor<1x256xi32, #mma>
