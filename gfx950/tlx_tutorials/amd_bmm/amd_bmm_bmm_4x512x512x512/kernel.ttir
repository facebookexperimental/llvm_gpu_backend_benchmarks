    %82 = tlx.require_layout %81 : tensor<128x128xf16> -> tensor<128x128xf16, #tlx.no_verify_layout<#shared4>>
    %83 = tlx.require_layout %80 : tensor<128x128x!tt.ptr<f16>> -> tensor<128x128x!tt.ptr<f16>, #tlx.no_verify_layout<#shared4>>
    %84 = tlx.require_layout %78 : tensor<128x128xi1> -> tensor<128x128xi1, #tlx.no_verify_layout<#shared4>>
    tt.store %83, %82, %84 : tensor<128x128x!tt.ptr<f16>, #tlx.no_verify_layout<#shared4>>
    tt.return
  }
}
