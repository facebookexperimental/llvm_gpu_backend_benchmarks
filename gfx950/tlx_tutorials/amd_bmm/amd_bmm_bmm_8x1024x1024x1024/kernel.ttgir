    %mm = tt.expand_dims %om_21 {axis = 1 : i32} : tensor<128xi32, #ttg.slice<{dim = 1, parent = #linear2}>> -> tensor<128x1xi32, #linear2>
    %mm_60 = tt.splat %M : i32 -> tensor<128x1xi32, #linear2>
    %mm_61 = arith.cmpi slt, %mm, %mm_60 : tensor<128x1xi32, #linear2>
    %44 = tt.reshape %acc_55 : tensor<128x256xf32, #linear3> -> tensor<128x2x128xf32, #linear4>
    %45 = tt.trans %44 {order = array<i32: 0, 2, 1>} : tensor<128x2x128xf32, #linear4> -> tensor<128x128x2xf32, #linear5>
    %outLHS, %outRHS = tt.split %45 : tensor<128x128x2xf32, #linear5> -> tensor<128x128xf32, #linear2>
    %46 = tt.expand_dims %rnl_58 {axis = 0 : i32} : tensor<128xi32, #ttg.slice<{dim = 0, parent = #linear2}>> -> tensor<1x128xi32, #linear2>
    %47 = tt.splat %N : i32 -> tensor<1x128xi32, #linear2>
    %48 = arith.cmpi slt, %46, %47 : tensor<1x128xi32, #linear2>
    %49 = tt.broadcast %mm_61 : tensor<128x1xi1, #linear2> -> tensor<128x128xi1, #linear2>
    %50 = tt.broadcast %48 : tensor<1x128xi1, #linear2> -> tensor<128x128xi1, #linear2>
    %51 = arith.andi %49, %50 : tensor<128x128xi1, #linear2>
    %52 = arith.muli %scm, %om : i32
    %53 = tt.expand_dims %om_16 {axis = 1 : i32} : tensor<128xi32, #ttg.slice<{dim = 1, parent = #linear2}>> -> tensor<128x1xi32, #linear2>
    %54 = tt.splat %scm : i32 -> tensor<128x1xi32, #linear2>
    %55 = arith.muli %54, %53 : tensor<128x1xi32, #linear2>
    %56 = arith.addi %52, %cb_57 : i32
    %57 = tt.broadcast %55 : tensor<128x1xi32, #linear2> -> tensor<128x128xi32, #linear2>
    %58 = tt.expand_dims %om_17 {axis = 0 : i32} : tensor<128xi32, #ttg.slice<{dim = 0, parent = #linear2}>> -> tensor<1x128xi32, #linear2>
    %59 = tt.broadcast %58 : tensor<1x128xi32, #linear2> -> tensor<128x128xi32, #linear2>
    %60 = arith.addi %56, %on : i32
    %61 = arith.addi %57, %59 : tensor<128x128xi32, #linear2>
    %62 = tt.splat %60 : i32 -> tensor<128x128xi32, #linear2>
    %63 = arith.addi %62, %61 : tensor<128x128xi32, #linear2>
    %64 = arith.truncf %outLHS : tensor<128x128xf32, #linear2> to tensor<128x128xf16, #linear2>
    amdg.buffer_store %64, %c_ptr[%63], %51 {contiguity = 8 : i32} : !tt.ptr<f16> -> tensor<128x128xf16, #linear2>
    %65 = tt.expand_dims %rnr_59 {axis = 0 : i32} : tensor<128xi32, #ttg.slice<{dim = 0, parent = #linear2}>> -> tensor<1x128xi32, #linear2>
    %66 = arith.cmpi slt, %65, %47 : tensor<1x128xi32, #linear2>
    %67 = tt.broadcast %66 : tensor<1x128xi1, #linear2> -> tensor<128x128xi1, #linear2>
    %68 = arith.andi %49, %67 : tensor<128x128xi1, #linear2>
    %69 = arith.addi %on, %c128_i32 : i32
    %70 = arith.addi %56, %69 : i32
    %71 = tt.splat %70 : i32 -> tensor<128x128xi32, #linear2>
    %72 = arith.addi %71, %61 : tensor<128x128xi32, #linear2>
    %73 = arith.truncf %outRHS : tensor<128x128xf32, #linear2> to tensor<128x128xf16, #linear2>
    amdg.buffer_store %73, %c_ptr[%72], %68 {contiguity = 8 : i32} : !tt.ptr<f16> -> tensor<128x128xf16, #linear2>
    tt.return
  }
}
