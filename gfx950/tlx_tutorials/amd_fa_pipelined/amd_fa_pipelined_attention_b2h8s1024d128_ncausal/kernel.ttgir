    %o_ptrs_54 = tt.broadcast %o_ptrs_52 : tensor<256x1xi32, #linear1> -> tensor<256x128xi32, #linear1>
    %o_ptrs_55 = tt.broadcast %q_31 : tensor<1x128xi32, #linear1> -> tensor<256x128xi32, #linear1>
    %o_ptrs_56 = arith.addi %o_ptrs_54, %o_ptrs_55 : tensor<256x128xi32, #linear1>
    %o_ptrs_57 = tt.splat %o_ptrs_53 : i32 -> tensor<256x128xi32, #linear1>
    %o_ptrs_58 = arith.addi %o_ptrs_57, %o_ptrs_56 : tensor<256x128xi32, #linear1>
    %12 = arith.cmpi slt, %q_31, %cst_1 : tensor<1x128xi32, #linear1>
    %13 = tt.broadcast %12 : tensor<1x128xi1, #linear1> -> tensor<256x128xi1, #linear1>
    %14 = arith.andi %q_42, %13 : tensor<256x128xi1, #linear1>
    %15 = arith.truncf %acc_49 : tensor<256x128xf32, #mma> to tensor<256x128xbf16, #mma>
    %16 = ttg.convert_layout %15 : tensor<256x128xbf16, #mma> -> tensor<256x128xbf16, #linear1>
    amdg.buffer_store %16, %Out[%o_ptrs_58], %14 {contiguity = 8 : i32} : !tt.ptr<bf16> -> tensor<256x128xbf16, #linear1>
    tt.return
  }
}
