    %o_ptrs = arith.muli %offs_m, %stride_om : i32
    %o_ptrs_56 = tt.expand_dims %offs_m_13 {axis = 1 : i32} : tensor<256xi32, #ttg.slice<{dim = 1, parent = #linear1}>> -> tensor<256x1xi32, #linear1>
    %o_ptrs_57 = tt.splat %stride_om : i32 -> tensor<256x1xi32, #linear1>
    %o_ptrs_58 = arith.muli %o_ptrs_56, %o_ptrs_57 : tensor<256x1xi32, #linear1>
    %o_ptrs_59 = arith.addi %o_ptrs, %o_off_12 : i32
    %o_ptrs_60 = tt.broadcast %o_ptrs_58 : tensor<256x1xi32, #linear1> -> tensor<256x128xi32, #linear1>
    %o_ptrs_61 = tt.broadcast %q_34 : tensor<1x128xi32, #linear1> -> tensor<256x128xi32, #linear1>
    %o_ptrs_62 = arith.addi %o_ptrs_60, %o_ptrs_61 : tensor<256x128xi32, #linear1>
    %o_ptrs_63 = tt.splat %o_ptrs_59 : i32 -> tensor<256x128xi32, #linear1>
    %o_ptrs_64 = arith.addi %o_ptrs_63, %o_ptrs_62 : tensor<256x128xi32, #linear1>
    %12 = arith.cmpi slt, %q_34, %cst_1 : tensor<1x128xi32, #linear1>
    %13 = tt.broadcast %12 : tensor<1x128xi1, #linear1> -> tensor<256x128xi1, #linear1>
    %14 = arith.andi %q_45, %13 : tensor<256x128xi1, #linear1>
    %15 = arith.truncf %acc_55 : tensor<256x128xf32, #mma> to tensor<256x128xbf16, #mma>
    %16 = ttg.convert_layout %15 : tensor<256x128xbf16, #mma> -> tensor<256x128xbf16, #linear1>
    amdg.buffer_store %16, %Out[%o_ptrs_64], %14 {contiguity = 8 : i32} : !tt.ptr<bf16> -> tensor<256x128xbf16, #linear1>
    tt.return
  }
}
