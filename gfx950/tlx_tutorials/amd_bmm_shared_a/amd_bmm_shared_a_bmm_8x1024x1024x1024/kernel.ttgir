    %61 = tt.expand_dims %on_24 {axis = 0 : i32} : tensor<256xi32, #ttg.slice<{dim = 0, parent = #linear2}>> -> tensor<1x256xi32, #linear2>
    %62 = tt.broadcast %61 : tensor<1x256xi32, #linear2> -> tensor<128x256xi32, #linear2>
    %63 = arith.addi %59, %on : i32
    %64 = arith.addi %60, %62 : tensor<128x256xi32, #linear2>
    %65 = tt.splat %63 : i32 -> tensor<128x256xi32, #linear2>
    %66 = arith.addi %65, %64 : tensor<128x256xi32, #linear2>
    %67 = arith.truncf %acc_54 : tensor<128x256xf32, #mma> to tensor<128x256xf16, #mma>
    %68 = ttg.convert_layout %67 : tensor<128x256xf16, #mma> -> tensor<128x256xf16, #linear2>
    amdg.buffer_store %68, %c_ptr[%66], %54 {contiguity = 8 : i32} : !tt.ptr<f16> -> tensor<128x256xf16, #linear2>
    tt.return
  }
}
