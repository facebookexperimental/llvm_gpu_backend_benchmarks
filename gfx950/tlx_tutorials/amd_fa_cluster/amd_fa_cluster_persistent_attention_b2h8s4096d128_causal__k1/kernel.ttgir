          %out_107 = ttg.convert_layout %out : tensor<256x128xbf16, #mma> -> tensor<256x128xbf16, #linear1>
          amdg.buffer_store %out_107, %Out[%o_ptrs_106] {contiguity = 8 : i32} : !tt.ptr<bf16> -> tensor<256x128xbf16, #linear1>
          ttg.barrier all
        }
      }
    } {tt.num_stages = 1 : i32}
    tt.return
  }
}
