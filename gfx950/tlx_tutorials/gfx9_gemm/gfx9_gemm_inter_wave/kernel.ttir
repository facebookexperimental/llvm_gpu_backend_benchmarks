    %24 = tlx.require_layout %ct_mask_62 : tensor<128x256xi1> -> tensor<128x256xi1, #tlx.no_verify_layout<#shared1>>
    tt.store %23, %c_top_70, %24 : tensor<128x256x!tt.ptr<f16>, #tlx.no_verify_layout<#shared1>>
    rocdl.sched.barrier none {triton.warp_pipeline.allow_memory_reorder, triton.warp_pipeline.border = "mem", triton.warp_pipeline.priority = 1 : i32}
    %25 = ttg.async_wait {num = 0 : i32}
    rocdl.sched.barrier none {triton.warp_pipeline.stage_begin = "mfma"}
    %acc_bot_71 = tt.dot %ab_cur_69, %b_cur_67, %acc_bot_65 : tensor<128x64xf16> * tensor<64x256xf16> -> tensor<128x256xf32>
    rocdl.sched.barrier none {triton.warp_pipeline.allow_memory_reorder, triton.warp_pipeline.border = "mfma", triton.warp_pipeline.priority = 0 : i32}
    rocdl.sched.barrier none {triton.warp_pipeline.stage_begin = "mem"}
    %26 = arith.truncf %acc_bot_71 : tensor<128x256xf32> to tensor<128x256xf16>
    %27 = tlx.require_layout %26 : tensor<128x256xf16> -> tensor<128x256xf16, #tlx.no_verify_layout<#shared1>>
    %28 = tlx.require_layout %cb_ptrs_58 : tensor<128x256x!tt.ptr<f16>> -> tensor<128x256x!tt.ptr<f16>, #tlx.no_verify_layout<#shared1>>
    %29 = tlx.require_layout %cb_mask_64 : tensor<128x256xi1> -> tensor<128x256xi1, #tlx.no_verify_layout<#shared1>>
    tt.store %28, %27, %29 : tensor<128x256x!tt.ptr<f16>, #tlx.no_verify_layout<#shared1>>
    rocdl.sched.barrier none {triton.warp_pipeline.allow_memory_reorder, triton.warp_pipeline.border = "mem", triton.warp_pipeline.priority = 1 : i32}
    tt.return
  }
}
