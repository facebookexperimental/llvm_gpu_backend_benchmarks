      %dact_qk_trans_108 = tt.dot %k_45, %dact_qk_trans_107, %cst_3 : tensor<128x128xbf16, #ttg.dot_op<{opIdx = 0, parent = #mma, kWidth = 8}>> * tensor<128x32xbf16, #ttg.dot_op<{opIdx = 1, parent = #mma, kWidth = 8}>> -> tensor<128x32xf32, #mma>
      %dqk_trans = arith.mulf %dact_qk_trans_108, %pT_101 : tensor<128x32xf32, #mma>
