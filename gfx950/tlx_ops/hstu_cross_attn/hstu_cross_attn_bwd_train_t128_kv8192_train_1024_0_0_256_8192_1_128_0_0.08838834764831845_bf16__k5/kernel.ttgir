      %cur_134 = amdg.buffer_load %DQ[%dq_ptrs_132], %cur_133, %cst_0 {contiguity = 4 : i32} : !tt.ptr<f32> -> tensor<32x128xf32, #blocked>
      %6 = arith.addf %cur_134, %dq : tensor<32x128xf32, #blocked>
