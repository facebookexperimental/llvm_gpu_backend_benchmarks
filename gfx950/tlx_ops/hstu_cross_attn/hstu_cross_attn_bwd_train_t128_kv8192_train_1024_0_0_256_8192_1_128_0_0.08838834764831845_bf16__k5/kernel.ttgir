      %dqk_trans_116 = ttg.convert_layout %dqk_trans_115 : tensor<128x32xbf16, #mma> -> tensor<128x32xbf16, #ttg.dot_op<{opIdx = 0, parent = #mma, kWidth = 4}>>
      %dk_attn = tt.dot %dqk_trans_116, %q, %cst_4 : tensor<128x32xbf16, #ttg.dot_op<{opIdx = 0, parent = #mma, kWidth = 4}>> * tensor<32x128xbf16, #ttg.dot_op<{opIdx = 1, parent = #mma, kWidth = 4}>> -> tensor<128x128xf32, #mma>
      %dk_117 = arith.mulf %dk_attn, %dk : tensor<128x128xf32, #mma>
      %dk_118 = arith.addf %dk_106, %dk_117 : tensor<128x128xf32, #mma>
      %dqk_trans_119 = ttg.convert_layout %dqk_trans_115 : tensor<128x32xbf16, #mma> -> tensor<128x32xbf16, #ttg.dot_op<{opIdx = 1, parent = #mma, kWidth = 8}>>
      %dq_trans_120 = tt.dot %dq_trans_55, %dqk_trans_119, %cst_3 : tensor<128x128xbf16, #ttg.dot_op<{opIdx = 0, parent = #mma, kWidth = 8}>> * tensor<128x32xbf16, #ttg.dot_op<{opIdx = 1, parent = #mma, kWidth = 8}>> -> tensor<128x32xf32, #mma>
      %dq_trans_121 = ttg.convert_layout %dq_trans_120 : tensor<128x32xf32, #mma> -> tensor<128x32xf32, #blocked2>
      %dq_trans_122 = arith.mulf %dq_trans_121, %dq_trans : tensor<128x32xf32, #blocked2>
      %dq = tt.trans %dq_trans_122 {order = array<i32: 1, 0>} : tensor<128x32xf32, #blocked2> -> tensor<32x128xf32, #blocked>
      %dq_ptrs_123 = arith.addi %dq_ptrs, %offs_m_70 : tensor<32xi32, #ttg.slice<{dim = 1, parent = #blocked}>>
      %dq_ptrs_124 = arith.extsi %dq_ptrs_123 : tensor<32xi32, #ttg.slice<{dim = 1, parent = #blocked}>> to tensor<32xi64, #ttg.slice<{dim = 1, parent = #blocked}>>
      %dq_ptrs_125 = tt.expand_dims %dq_ptrs_124 {axis = 1 : i32} : tensor<32xi64, #ttg.slice<{dim = 1, parent = #blocked}>> -> tensor<32x1xi64, #blocked>
      %dq_ptrs_126 = tt.splat %dq_ptrs_26 : i64 -> tensor<32x1xi64, #blocked>
