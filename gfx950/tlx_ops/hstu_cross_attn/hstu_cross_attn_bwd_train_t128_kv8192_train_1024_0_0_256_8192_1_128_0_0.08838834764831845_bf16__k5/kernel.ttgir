    %dk_ptrs_57 = tt.expand_dims %ptrs_32 {axis = 1 : i32} : tensor<128xi64, #ttg.slice<{dim = 1, parent = #linear1}>> -> tensor<128x1xi64, #linear1>
    %dk_ptrs_58 = tt.splat %dk_ptrs : i64 -> tensor<128x1xi64, #linear1>
