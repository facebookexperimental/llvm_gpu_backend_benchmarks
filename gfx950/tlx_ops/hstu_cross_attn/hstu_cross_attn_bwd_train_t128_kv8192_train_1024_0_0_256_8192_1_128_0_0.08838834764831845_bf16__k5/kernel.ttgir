    %mask_n_65 = arith.cmpi slt, %offs_n_48, %mask_n : tensor<128xi32, #ttg.slice<{dim = 1, parent = #linear1}>>
    %1 = tt.expand_dims %mask_n_65 {axis = 1 : i32} : tensor<128xi1, #ttg.slice<{dim = 1, parent = #linear1}>> -> tensor<128x1xi1, #linear1>
