          scf.yield %acc_142 : tensor<128x64xf32, #mma>
        }
        scf.yield %acc_81 : tensor<128x64xf32, #mma>
      } else {
        scf.yield %cst_10 : tensor<128x64xf32, #mma>
      }
      %off_o = arith.extsi %stride_om : i32 to i64
      %off_o_65 = arith.muli %seq_start_q_21, %off_o : i64
      %off_o_66 = arith.trunci %off_o_65 : i64 to i32
      %off_o_67 = arith.muli %off_h, %stride_oh : i32
      %off_o_68 = arith.addi %off_o_66, %off_o_67 : i32
      %out_ptrs = arith.muli %start_m_16, %stride_om : i32
      %out_ptrs_69 = tt.make_range {end = 64 : i32, start = 0 : i32} : tensor<64xi32, #ttg.slice<{dim = 0, parent = #linear2}>>
      %out_ptrs_70 = tt.expand_dims %offs_m_24 {axis = 1 : i32} : tensor<128xi32, #ttg.slice<{dim = 1, parent = #linear2}>> -> tensor<128x1xi32, #linear2>
      %out_ptrs_71 = tt.splat %stride_om : i32 -> tensor<128x1xi32, #linear2>
      %out_ptrs_72 = arith.muli %out_ptrs_70, %out_ptrs_71 : tensor<128x1xi32, #linear2>
      %out_ptrs_73 = arith.addi %out_ptrs, %off_o_68 : i32
      %out_ptrs_74 = tt.broadcast %out_ptrs_72 : tensor<128x1xi32, #linear2> -> tensor<128x64xi32, #linear2>
      %out_ptrs_75 = tt.expand_dims %out_ptrs_69 {axis = 0 : i32} : tensor<64xi32, #ttg.slice<{dim = 0, parent = #linear2}>> -> tensor<1x64xi32, #linear2>
      %out_ptrs_76 = tt.broadcast %out_ptrs_75 : tensor<1x64xi32, #linear2> -> tensor<128x64xi32, #linear2>
      %out_ptrs_77 = arith.addi %out_ptrs_74, %out_ptrs_76 : tensor<128x64xi32, #linear2>
      %out_ptrs_78 = tt.splat %out_ptrs_73 : i32 -> tensor<128x64xi32, #linear2>
      %out_ptrs_79 = arith.addi %out_ptrs_78, %out_ptrs_77 : tensor<128x64xi32, #linear2>
      %acc = arith.truncf %10 : tensor<128x64xf32, #mma> to tensor<128x64xbf16, #mma>
      %acc_80 = ttg.convert_layout %acc : tensor<128x64xbf16, #mma> -> tensor<128x64xbf16, #linear2>
      amdg.buffer_store %acc_80, %Out[%out_ptrs_79], %q_61 {contiguity = 8 : i32} : !tt.ptr<bf16> -> tensor<128x64xbf16, #linear2>
    }
    tt.return
  }
}
