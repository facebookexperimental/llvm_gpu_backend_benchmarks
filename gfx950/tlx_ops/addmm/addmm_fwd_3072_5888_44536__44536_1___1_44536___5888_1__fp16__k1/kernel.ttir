      %partial_36 = tt.addptr %partial_17, %partial_35 : tensor<32x32x!tt.ptr<f32>>, tensor<32x32xi32>
      %partial_37 = tt.load %partial_36, %mask_12, %cst : tensor<32x32x!tt.ptr<f32>>
      %acc_38 = arith.addf %acc_32, %partial_37 : tensor<32x32xf32>
      scf.yield %acc_38 : tensor<32x32xf32>
