    %offs_n_4 = arith.addi %offs_n_3, %offs_m_0 : tensor<32xi32>
    %mask = tt.expand_dims %offs_m_2 {axis = 1 : i32} : tensor<32xi32> -> tensor<32x1xi32>
    %mask_5 = tt.splat %M : i32 -> tensor<32x1xi32>
    %mask_6 = arith.cmpi slt, %mask, %mask_5 : tensor<32x1xi32>
    %mask_7 = tt.expand_dims %offs_n_4 {axis = 0 : i32} : tensor<32xi32> -> tensor<1x32xi32>
    %mask_8 = tt.splat %N : i32 -> tensor<1x32xi32>
    %mask_9 = arith.cmpi slt, %mask_7, %mask_8 : tensor<1x32xi32>
    %mask_10 = tt.broadcast %mask_6 : tensor<32x1xi1> -> tensor<32x32xi1>
    %mask_11 = tt.broadcast %mask_9 : tensor<1x32xi1> -> tensor<32x32xi1>
    %mask_12 = arith.andi %mask_10, %mask_11 : tensor<32x32xi1>
    %base_offs = tt.splat %N : i32 -> tensor<32x1xi32>
    %base_offs_13 = arith.muli %mask, %base_offs : tensor<32x1xi32>
    %base_offs_14 = tt.broadcast %base_offs_13 : tensor<32x1xi32> -> tensor<32x32xi32>
    %base_offs_15 = tt.broadcast %mask_7 : tensor<1x32xi32> -> tensor<32x32xi32>
    %base_offs_16 = arith.addi %base_offs_14, %base_offs_15 : tensor<32x32xi32>
    %partial = tt.splat %workspace_ptr : !tt.ptr<f32> -> tensor<32x32x!tt.ptr<f32>>
    %partial_17 = tt.addptr %partial, %base_offs_16 : tensor<32x32x!tt.ptr<f32>>, tensor<32x32xi32>
    %acc = scf.for %s = %c0_i32 to %c2_i32 step %c1_i32 iter_args(%acc_32 = %cst) -> (tensor<32x32xf32>)  : i32 {
      %partial_33 = arith.muli %s, %M : i32
      %partial_34 = arith.muli %partial_33, %N : i32
