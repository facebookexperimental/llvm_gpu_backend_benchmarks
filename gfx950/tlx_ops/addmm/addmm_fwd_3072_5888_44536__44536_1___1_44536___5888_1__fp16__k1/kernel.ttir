    %output_offsets_30 = tt.broadcast %output_offsets_28 : tensor<1x32xi32> -> tensor<32x32xi32>
    %output_offsets_31 = arith.addi %output_offsets_29, %output_offsets_30 : tensor<32x32xi32>
    %0 = tt.splat %c_ptr : !tt.ptr<f16> -> tensor<32x32x!tt.ptr<f16>>
    %1 = tt.addptr %0, %output_offsets_31 : tensor<32x32x!tt.ptr<f16>>, tensor<32x32xi32>
    %2 = arith.truncf %acc_27 : tensor<32x32xf32> to tensor<32x32xf16>
    tt.store %1, %2, %mask_12 : tensor<32x32x!tt.ptr<f16>>
