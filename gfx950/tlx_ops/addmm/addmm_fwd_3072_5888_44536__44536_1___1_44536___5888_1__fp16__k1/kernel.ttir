    %bias_25 = tt.load %bias_24, %mask_12, %bias : tensor<32x32x!tt.ptr<f16>>
    %acc_26 = arith.extf %bias_25 : tensor<32x32xf16> to tensor<32x32xf32>
    %acc_27 = arith.addf %acc, %acc_26 : tensor<32x32xf32>
