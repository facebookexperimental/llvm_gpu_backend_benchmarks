    %a_tail_134 = ttg.convert_layout %a_tail_79 : tensor<16x128xf16, #blocked> -> tensor<16x128xf16, #ttg.dot_op<{opIdx = 0, parent = #mma, kWidth = 8}>>
    %acc_tail = tt.dot %a_tail_134, %b_value_126, %value_133 : tensor<16x128xf16, #ttg.dot_op<{opIdx = 0, parent = #mma, kWidth = 8}>> * tensor<128x128xf16, #ttg.dot_op<{opIdx = 1, parent = #mma, kWidth = 8}>> -> tensor<16x128xf32, #mma>
    %0 = arith.truncf %acc_head : tensor<64x128xf32, #mma> to tensor<64x128xf16, #mma>
    amdg.buffer_store %0, %c_ptr[%head_ptrs_93], %head_mask_110 : !tt.ptr<f16> -> tensor<64x128xf16, #mma>
    %1 = arith.truncf %acc_tail : tensor<16x128xf32, #mma> to tensor<16x128xf16, #mma>
    amdg.buffer_store %1, %c_ptr[%tail_ptrs_101], %tail_mask_117 : !tt.ptr<f16> -> tensor<16x128xf16, #mma>
    tt.return
  }
}
