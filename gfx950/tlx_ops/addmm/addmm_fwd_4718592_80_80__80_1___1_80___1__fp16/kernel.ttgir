    %a_tail_135 = ttg.convert_layout %a_tail_80 : tensor<64x128xf16, #blocked> -> tensor<64x128xf16, #ttg.dot_op<{opIdx = 0, parent = #mma, kWidth = 8}>>
    %acc_tail = tt.dot %a_tail_135, %b_value_127, %value_134 : tensor<64x128xf16, #ttg.dot_op<{opIdx = 0, parent = #mma, kWidth = 8}>> * tensor<128x256xf16, #ttg.dot_op<{opIdx = 1, parent = #mma, kWidth = 8}>> -> tensor<64x256xf32, #mma>
    %0 = arith.truncf %acc_head : tensor<16x256xf32, #mma> to tensor<16x256xf16, #mma>
    amdg.buffer_store %0, %c_ptr[%head_ptrs_94], %head_mask_111 : !tt.ptr<f16> -> tensor<16x256xf16, #mma>
    %1 = arith.truncf %acc_tail : tensor<64x256xf32, #mma> to tensor<64x256xf16, #mma>
    amdg.buffer_store %1, %c_ptr[%tail_ptrs_102], %tail_mask_118 : !tt.ptr<f16> -> tensor<64x256xf16, #mma>
    tt.return
  }
}
