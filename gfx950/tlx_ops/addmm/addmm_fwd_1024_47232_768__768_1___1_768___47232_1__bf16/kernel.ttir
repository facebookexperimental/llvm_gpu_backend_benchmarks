    %89 = arith.truncf %acc_br_57 : tensor<128x128xf32, #tlx.no_verify_layout<#mma>> to tensor<128x128xbf16, #tlx.no_verify_layout<#mma>>
    %90 = tlx.require_layout %89 : tensor<128x128xbf16, #tlx.no_verify_layout<#mma>> -> tensor<128x128xbf16, #tlx.no_verify_layout<#shared4>>
    %91 = tlx.require_layout %88 : tensor<128x128x!tt.ptr<bf16>> -> tensor<128x128x!tt.ptr<bf16>, #tlx.no_verify_layout<#shared4>>
    %92 = tlx.require_layout %87 : tensor<128x128xi1> -> tensor<128x128xi1, #tlx.no_verify_layout<#shared4>>
    tt.store %91, %90, %92 {cachePolicy = #tt.cache_policy<cache_modifier = cs, eviction_policy = evict_normal>} : tensor<128x128x!tt.ptr<bf16>, #tlx.no_verify_layout<#shared4>>
    tt.return
  }
}
