    %bias_894 = tlx.require_layout %bias_893 : tensor<32x64x!tt.ptr<f16>> -> tensor<32x64x!tt.ptr<f16>, #tlx.no_verify_layout<#linear6>>
    %bias_895 = tlx.require_layout %mask_892 : tensor<32x64xi1> -> tensor<32x64xi1, #tlx.no_verify_layout<#linear6>>
    %bias_896 = tt.load %bias_894, %bias_895, %bias_663 : tensor<32x64x!tt.ptr<f16>, #tlx.no_verify_layout<#linear6>>
    %value_897 = arith.extf %bias_896 : tensor<32x64xf16, #tlx.no_verify_layout<#linear6>> to tensor<32x64xf32, #tlx.no_verify_layout<#linear6>>
    %value_898 = arith.addf %value_891, %value_897 : tensor<32x64xf32, #tlx.no_verify_layout<#linear6>>
    %value_899 = arith.truncf %value_898 : tensor<32x64xf32, #tlx.no_verify_layout<#linear6>> to tensor<32x64xf16, #tlx.no_verify_layout<#linear6>>
    %ptrs_900 = tt.addptr %ptrs_875, %bias_700 : tensor<32x64x!tt.ptr<f16>>, tensor<32x64xi32>
    %16 = tlx.require_layout %ptrs_900 : tensor<32x64x!tt.ptr<f16>> -> tensor<32x64x!tt.ptr<f16>, #tlx.no_verify_layout<#linear6>>
    tt.store %16, %value_899, %bias_895 : tensor<32x64x!tt.ptr<f16>, #tlx.no_verify_layout<#linear6>>
    tt.return
  }
}
