    %24 = tlx.require_layout %ptrs_728 : tensor<32x32x!tt.ptr<f16>> -> tensor<32x32x!tt.ptr<f16>, #tlx.no_verify_layout<#mma>>
    %25 = tlx.require_layout %fragment_mask_729 : tensor<32x32xi1> -> tensor<32x32xi1, #tlx.no_verify_layout<#mma>>
    tt.store %24, %value_730, %25 : tensor<32x32x!tt.ptr<f16>, #tlx.no_verify_layout<#mma>>
    tt.return
  }
}
