    %11 = arith.addi %7, %9 : tensor<16x16xi32, #mma>
    %12 = tt.splat %10 : i32 -> tensor<16x16xi32, #mma>
    %13 = arith.addi %12, %11 : tensor<16x16xi32, #mma>
    %14 = arith.truncf %acc_80 : tensor<16x16xf32, #mma> to tensor<16x16xf16, #mma>
    amdg.buffer_store %14, %c_ptr[%13], %mask_85 {contiguity = 4 : i32} : !tt.ptr<f16> -> tensor<16x16xf16, #mma>
    tt.return
  }
}
