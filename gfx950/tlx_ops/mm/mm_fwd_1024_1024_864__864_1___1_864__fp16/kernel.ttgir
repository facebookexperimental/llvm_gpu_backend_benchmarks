    %rows = arith.addi %input_rows_14, %input_rows_12 : tensor<64xi32, #ttg.slice<{dim = 1, parent = #mma}>>
    %cols = arith.addi %input_cols_15, %input_rows_13 : tensor<64xi32, #ttg.slice<{dim = 0, parent = #mma}>>
    %idx_m = tt.expand_dims %rows {axis = 1 : i32} : tensor<64xi32, #ttg.slice<{dim = 1, parent = #mma}>> -> tensor<64x1xi32, #mma>
    %idx_n = tt.expand_dims %cols {axis = 0 : i32} : tensor<64xi32, #ttg.slice<{dim = 0, parent = #mma}>> -> tensor<1x64xi32, #mma>
    %mask_95 = arith.cmpi slt, %idx_m, %cst_3 : tensor<64x1xi32, #mma>
    %mask_96 = arith.cmpi slt, %idx_n, %mask : tensor<1x64xi32, #mma>
    %mask_97 = tt.broadcast %mask_95 : tensor<64x1xi1, #mma> -> tensor<64x64xi1, #mma>
    %mask_98 = tt.broadcast %mask_96 : tensor<1x64xi1, #mma> -> tensor<64x64xi1, #mma>
    %mask_99 = arith.andi %mask_97, %mask_98 : tensor<64x64xi1, #mma>
    %2 = tt.expand_dims %input_rows_12 {axis = 1 : i32} : tensor<64xi32, #ttg.slice<{dim = 1, parent = #mma}>> -> tensor<64x1xi32, #mma>
    %3 = arith.muli %pid_m_6, %c65536_i32 : i32
    %4 = arith.muli %2, %cst_3 : tensor<64x1xi32, #mma>
    %5 = tt.broadcast %4 : tensor<64x1xi32, #mma> -> tensor<64x64xi32, #mma>
    %6 = tt.expand_dims %input_rows_13 {axis = 0 : i32} : tensor<64xi32, #ttg.slice<{dim = 0, parent = #mma}>> -> tensor<1x64xi32, #mma>
    %7 = tt.broadcast %6 : tensor<1x64xi32, #mma> -> tensor<64x64xi32, #mma>
    %8 = arith.addi %3, %input_cols : i32
    %9 = arith.addi %5, %7 : tensor<64x64xi32, #mma>
    %10 = tt.splat %8 : i32 -> tensor<64x64xi32, #mma>
    %11 = arith.addi %10, %9 : tensor<64x64xi32, #mma>
    %12 = arith.truncf %acc_94 : tensor<64x64xf32, #mma> to tensor<64x64xf16, #mma>
    amdg.buffer_store %12, %c_ptr[%11], %mask_99 {contiguity = 4 : i32} : !tt.ptr<f16> -> tensor<64x64xf16, #mma>
    tt.return
  }
}
