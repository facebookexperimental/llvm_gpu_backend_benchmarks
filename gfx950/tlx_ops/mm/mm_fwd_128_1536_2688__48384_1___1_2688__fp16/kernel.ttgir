    %acc_95 = tt.dot %a_93, %b_94, %acc_66 : tensor<32x256xf16, #ttg.dot_op<{opIdx = 0, parent = #mma, kWidth = 8}>> * tensor<256x32xf16, #ttg.dot_op<{opIdx = 1, parent = #mma, kWidth = 8}>> -> tensor<32x32xf32, #mma>
    %rows = arith.addi %input_rows_16, %input_rows_14 : tensor<32xi32, #ttg.slice<{dim = 1, parent = #mma}>>
    %cols = arith.addi %input_cols_17, %input_rows_15 : tensor<32xi32, #ttg.slice<{dim = 0, parent = #mma}>>
    %idx_m = tt.expand_dims %rows {axis = 1 : i32} : tensor<32xi32, #ttg.slice<{dim = 1, parent = #mma}>> -> tensor<32x1xi32, #mma>
    %idx_n = tt.expand_dims %cols {axis = 0 : i32} : tensor<32xi32, #ttg.slice<{dim = 0, parent = #mma}>> -> tensor<1x32xi32, #mma>
    %mask_96 = arith.cmpi slt, %idx_m, %mask : tensor<32x1xi32, #mma>
    %mask_97 = arith.cmpi slt, %idx_n, %mask_3 : tensor<1x32xi32, #mma>
    %mask_98 = tt.broadcast %mask_96 : tensor<32x1xi1, #mma> -> tensor<32x32xi1, #mma>
    %mask_99 = tt.broadcast %mask_97 : tensor<1x32xi1, #mma> -> tensor<32x32xi1, #mma>
    %mask_100 = arith.andi %mask_98, %mask_99 : tensor<32x32xi1, #mma>
    %2 = tt.expand_dims %input_rows_14 {axis = 1 : i32} : tensor<32xi32, #ttg.slice<{dim = 1, parent = #mma}>> -> tensor<32x1xi32, #mma>
    %3 = tt.broadcast %2 : tensor<32x1xi32, #mma> -> tensor<32x32xi32, #mma>
    %4 = tt.expand_dims %input_rows_15 {axis = 0 : i32} : tensor<32xi32, #ttg.slice<{dim = 0, parent = #mma}>> -> tensor<1x32xi32, #mma>
    %5 = arith.muli %pid_n_9, %c49152_i32 : i32
    %6 = arith.muli %4, %cst : tensor<1x32xi32, #mma>
    %7 = tt.broadcast %6 : tensor<1x32xi32, #mma> -> tensor<32x32xi32, #mma>
    %8 = arith.addi %input_rows, %5 : i32
    %9 = arith.addi %3, %7 : tensor<32x32xi32, #mma>
    %10 = tt.splat %8 : i32 -> tensor<32x32xi32, #mma>
    %11 = arith.addi %10, %9 : tensor<32x32xi32, #mma>
    %12 = arith.truncf %acc_95 : tensor<32x32xf32, #mma> to tensor<32x32xf16, #mma>
    amdg.buffer_store %12, %c_ptr[%11], %mask_100 : !tt.ptr<f16> -> tensor<32x32xf16, #mma>
    tt.return
  }
}
