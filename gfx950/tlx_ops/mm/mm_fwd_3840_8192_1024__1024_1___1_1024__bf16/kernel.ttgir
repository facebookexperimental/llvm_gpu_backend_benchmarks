    %78 = tt.broadcast %n_left : tensor<1x128xi1, #linear> -> tensor<128x128xi1, #linear>
    %79 = arith.andi %77, %78 : tensor<128x128xi1, #linear>
    %80 = tt.expand_dims %offs_am_8 {axis = 1 : i32} : tensor<128xi32, #ttg.slice<{dim = 1, parent = #linear}>> -> tensor<128x1xi32, #linear>
    %81 = tt.broadcast %80 : tensor<128x1xi32, #linear> -> tensor<128x128xi32, #linear>
    %82 = tt.expand_dims %offs_am_10 {axis = 0 : i32} : tensor<128xi32, #ttg.slice<{dim = 0, parent = #linear}>> -> tensor<1x128xi32, #linear>
    %83 = arith.muli %offs_bn, %stride_cn : i32
    %84 = tt.splat %stride_cn : i32 -> tensor<1x128xi32, #linear>
    %85 = arith.muli %82, %84 : tensor<1x128xi32, #linear>
