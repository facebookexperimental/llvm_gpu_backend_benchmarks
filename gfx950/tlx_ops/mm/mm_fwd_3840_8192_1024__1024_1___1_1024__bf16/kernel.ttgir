    %87 = arith.addi %offs_am, %83 : i32
    %88 = arith.addi %81, %86 : tensor<128x128xi32, #linear>
    %89 = tt.splat %87 : i32 -> tensor<128x128xi32, #linear>
    %90 = arith.addi %89, %88 : tensor<128x128xi32, #linear>
    amdg.buffer_store %c_tl_28, %c_ptr[%90], %79 {cachePolicy = #tt.cache_policy<cache_modifier = cs, eviction_policy = evict_normal>, contiguity = 8 : i32} : !tt.ptr<bf16> -> tensor<128x128xbf16, #linear>
    %91 = tt.broadcast %m_bot : tensor<128x1xi1, #linear> -> tensor<128x128xi1, #linear>
    %92 = arith.andi %91, %78 : tensor<128x128xi1, #linear>
    %93 = arith.addi %offs_am_bot, %83 : i32
    %94 = tt.splat %93 : i32 -> tensor<128x128xi32, #linear>
    %95 = arith.addi %94, %88 : tensor<128x128xi32, #linear>
    %96 = arith.truncf %acc_bl_24 : tensor<128x128xf32, #mma> to tensor<128x128xbf16, #mma>
    %97 = ttg.convert_layout %96 : tensor<128x128xbf16, #mma> -> tensor<128x128xbf16, #linear>
    amdg.buffer_store %97, %c_ptr[%95], %92 {cachePolicy = #tt.cache_policy<cache_modifier = cs, eviction_policy = evict_normal>, contiguity = 8 : i32} : !tt.ptr<bf16> -> tensor<128x128xbf16, #linear>
    %98 = tt.broadcast %n_right : tensor<1x128xi1, #linear> -> tensor<128x128xi1, #linear>
    %99 = arith.andi %77, %98 : tensor<128x128xi1, #linear>
    %100 = arith.muli %offs_bn_right, %stride_cn : i32
    %101 = arith.addi %offs_am, %100 : i32
