    amdg.buffer_store %105, %c_ptr[%103], %99 {cachePolicy = #tt.cache_policy<cache_modifier = cs, eviction_policy = evict_normal>, contiguity = 8 : i32} : !tt.ptr<bf16> -> tensor<128x128xbf16, #linear>
    %106 = arith.andi %91, %98 : tensor<128x128xi1, #linear>
    %107 = arith.addi %offs_am_bot, %100 : i32
    %108 = tt.splat %107 : i32 -> tensor<128x128xi32, #linear>
    %109 = arith.addi %108, %88 : tensor<128x128xi32, #linear>
    %110 = arith.truncf %acc_br_27 : tensor<128x128xf32, #mma> to tensor<128x128xbf16, #mma>
    %111 = ttg.convert_layout %110 : tensor<128x128xbf16, #mma> -> tensor<128x128xbf16, #linear>
    amdg.buffer_store %111, %c_ptr[%109], %106 {cachePolicy = #tt.cache_policy<cache_modifier = cs, eviction_policy = evict_normal>, contiguity = 8 : i32} : !tt.ptr<bf16> -> tensor<128x128xbf16, #linear>
