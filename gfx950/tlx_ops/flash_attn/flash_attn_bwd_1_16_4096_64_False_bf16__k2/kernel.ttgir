      %p_71 = arith.subf %p, %lse_full_70 : tensor<256x32xf32, #mma>
      %p_72 = math.exp2 %p_71 : tensor<256x32xf32, #mma>
      %p_nd = arith.truncf %p_72 : tensor<256x32xf32, #mma> to tensor<256x32xbf16, #mma>
      %p_nd_73 = ttg.convert_layout %p_nd : tensor<256x32xbf16, #mma> -> tensor<256x32xbf16, #ttg.dot_op<{opIdx = 0, parent = #mma, kWidth = 4}>>
      %dv_74 = tt.dot %p_nd_73, %do_nd, %dk_61 : tensor<256x32xbf16, #ttg.dot_op<{opIdx = 0, parent = #mma, kWidth = 4}>> * tensor<32x64xbf16, #ttg.dot_op<{opIdx = 1, parent = #mma, kWidth = 4}>> -> tensor<256x64xf32, #mma>
      %dp = tt.dot %v_nm, %do_t_63, %cst_2 : tensor<256x64xbf16, #ttg.dot_op<{opIdx = 0, parent = #mma, kWidth = 8}>> * tensor<64x32xbf16, #ttg.dot_op<{opIdx = 1, parent = #mma, kWidth = 8}>> -> tensor<256x32xf32, #mma>
      %delta_full = tt.expand_dims %delta {axis = 0 : i32} : tensor<32xf32, #ttg.slice<{dim = 0, parent = #mma}>> -> tensor<1x32xf32, #mma>
      %delta_full_75 = tt.broadcast %delta_full : tensor<1x32xf32, #mma> -> tensor<256x32xf32, #mma>
      %ds = arith.subf %dp, %delta_full_75 : tensor<256x32xf32, #mma>
      %ds_76 = arith.mulf %p_72, %ds : tensor<256x32xf32, #mma>
      %ds_bf16 = arith.truncf %ds_76 : tensor<256x32xf32, #mma> to tensor<256x32xbf16, #mma>
      %ds_nd = ttg.convert_layout %ds_bf16 : tensor<256x32xbf16, #mma> -> tensor<256x32xbf16, #ttg.dot_op<{opIdx = 0, parent = #mma, kWidth = 4}>>
      %dk_77 = tt.dot %ds_nd, %q_nd, %dk : tensor<256x32xbf16, #ttg.dot_op<{opIdx = 0, parent = #mma, kWidth = 4}>> * tensor<32x64xbf16, #ttg.dot_op<{opIdx = 1, parent = #mma, kWidth = 4}>> -> tensor<256x64xf32, #mma>
      %ds_dm = ttg.convert_layout %ds_bf16 : tensor<256x32xbf16, #mma> -> tensor<256x32xbf16, #ttg.dot_op<{opIdx = 1, parent = #mma, kWidth = 4}>>
      %dq = tt.dot %kt_dm_41, %ds_dm, %cst_3 : tensor<64x256xbf16, #ttg.dot_op<{opIdx = 0, parent = #mma, kWidth = 4}>> * tensor<256x32xbf16, #ttg.dot_op<{opIdx = 1, parent = #mma, kWidth = 4}>> -> tensor<64x32xf32, #mma>
      %dq_78 = arith.mulf %dq, %dq_scale : tensor<64x32xf32, #mma>
      %dq_offsets_79 = tt.expand_dims %offs_m_65 {axis = 0 : i32} : tensor<32xi32, #ttg.slice<{dim = 0, parent = #mma}>> -> tensor<1x32xi32, #mma>
      %dq_offsets_80 = arith.muli %dq_offsets_79, %cst_0 : tensor<1x32xi32, #mma>
      %dq_offsets_81 = tt.broadcast %dq_offsets_80 : tensor<1x32xi32, #mma> -> tensor<64x32xi32, #mma>
      %dq_offsets_82 = arith.addi %dq_offsets_81, %dq_offsets_55 : tensor<64x32xi32, #mma>
      %7 = tt.addptr %DQ_ACC, %dq_acc_base : !tt.ptr<f32>, i32
      %8 = amdg.buffer_atomic_rmw fadd, relaxed, gpu, %dq_78, %7[%dq_offsets_82] : !tt.ptr<f32> -> tensor<64x32xf32, #mma>
      ttg.barrier all
      scf.yield %dk_77, %dv_74 : tensor<256x64xf32, #mma>, tensor<256x64xf32, #mma>
    }
    %output_offsets = tt.broadcast %key_ptrs_21 : tensor<256x1xi32, #linear> -> tensor<256x64xi32, #linear>
    %output_offsets_56 = tt.broadcast %key_ptrs_28 : tensor<1x64xi32, #linear> -> tensor<256x64xi32, #linear>
    %output_offsets_57 = arith.addi %output_offsets, %output_offsets_56 : tensor<256x64xi32, #linear>
    %dk_out = arith.mulf %dv#0, %dk_scale : tensor<256x64xf32, #mma>
    %dk_out_58 = arith.truncf %dk_out : tensor<256x64xf32, #mma> to tensor<256x64xbf16, #mma>
    %dk_out_59 = ttg.convert_layout %dk_out_58 : tensor<256x64xbf16, #mma> -> tensor<256x64xbf16, #linear>
    %dv_out = arith.truncf %dv#1 : tensor<256x64xf32, #mma> to tensor<256x64xbf16, #mma>
    %dv_out_60 = ttg.convert_layout %dv_out : tensor<256x64xbf16, #mma> -> tensor<256x64xbf16, #linear>
    %2 = tt.addptr %DK_OWNER, %dq_acc_base : !tt.ptr<bf16>, i32
    amdg.buffer_store %dk_out_59, %2[%output_offsets_57] : !tt.ptr<bf16> -> tensor<256x64xbf16, #linear>
    %3 = tt.addptr %DV_OWNER, %dq_acc_base : !tt.ptr<bf16>, i32
    amdg.buffer_store %dv_out_60, %3[%output_offsets_57] : !tt.ptr<bf16> -> tensor<256x64xbf16, #linear>
    tt.return
  }
}
