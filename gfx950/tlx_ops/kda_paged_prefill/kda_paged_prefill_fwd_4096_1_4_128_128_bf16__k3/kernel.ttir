      %state_236 = tlx.require_layout %v0_191 : tensor<64x32xbf16, #tlx.no_verify_layout<#shared10>> -> tensor<64x32xbf16, #tlx.no_verify_layout<#shared11>>
      %state_237 = tt.dot %state_236, %kg0_233, %state_230 : tensor<64x32xbf16, #tlx.no_verify_layout<#shared11>> * tensor<32x128xbf16, #tlx.no_verify_layout<#ttg.dot_op<{opIdx = 1, parent = #mma, kWidth = 4}>>> -> tensor<64x128xf32, #tlx.no_verify_layout<#mma>>
      %state_238 = tlx.require_layout %v1_195 : tensor<64x32xbf16, #tlx.no_verify_layout<#shared10>> -> tensor<64x32xbf16, #tlx.no_verify_layout<#shared11>>
      %state_239 = tt.dot %state_238, %kg1_235, %state_237 : tensor<64x32xbf16, #tlx.no_verify_layout<#shared11>> * tensor<32x128xbf16, #tlx.no_verify_layout<#ttg.dot_op<{opIdx = 1, parent = #mma, kWidth = 4}>>> -> tensor<64x128xf32, #tlx.no_verify_layout<#mma>>
