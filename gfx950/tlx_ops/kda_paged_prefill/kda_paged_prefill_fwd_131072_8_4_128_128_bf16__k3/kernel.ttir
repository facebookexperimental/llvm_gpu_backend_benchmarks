      %state_239 = tt.dot %state_238, %kg0_235, %state_232 : tensor<128x32xbf16, #tlx.no_verify_layout<#shared10>> * tensor<32x128xbf16, #tlx.no_verify_layout<#ttg.dot_op<{opIdx = 1, parent = #mma, kWidth = 4}>>> -> tensor<128x128xf32, #tlx.no_verify_layout<#mma>>
      %state_240 = tlx.require_layout %v1_197 : tensor<128x32xbf16, #tlx.no_verify_layout<#shared9>> -> tensor<128x32xbf16, #tlx.no_verify_layout<#shared10>>
