    %values_2 = tt.splat %values_0 : i32 -> tensor<16xi32>
    %values_3 = arith.addi %values_2, %values_1 : tensor<16xi32>
    %keys = tt.make_range {end = 128 : i32, start = 0 : i32} : tensor<128xi32>
    %state_offsets_4 = tt.expand_dims %values_3 {axis = 1 : i32} : tensor<16xi32> -> tensor<16x1xi32>
    %state_offsets_5 = arith.muli %state_offsets_4, %state_offsets : tensor<16x1xi32>
    %state_offsets_6 = tt.expand_dims %keys {axis = 0 : i32} : tensor<128xi32> -> tensor<1x128xi32>
    %state_offsets_7 = tt.broadcast %state_offsets_5 : tensor<16x1xi32> -> tensor<16x128xi32>
    %state_offsets_8 = tt.broadcast %state_offsets_6 : tensor<1x128xi32> -> tensor<16x128xi32>
    %state_offsets_9 = arith.addi %state_offsets_7, %state_offsets_8 : tensor<16x128xi32>
    %m_offsets_10 = tt.expand_dims %keys {axis = 1 : i32} : tensor<128xi32> -> tensor<128x1xi32>
    %m_offsets_11 = arith.muli %m_offsets_10, %m_offsets : tensor<128x1xi32>
    %m_offsets_12 = tt.broadcast %m_offsets_11 : tensor<128x1xi32> -> tensor<128x128xi32>
    %m_offsets_13 = tt.broadcast %state_offsets_6 : tensor<1x128xi32> -> tensor<128x128xi32>
    %m_offsets_14 = arith.addi %m_offsets_12, %m_offsets_13 : tensor<128x128xi32>
    %state = arith.addi %planes, %sequence_head : i32
    %state_15 = arith.extsi %state : i32 to i64
    %state_16 = arith.muli %state_15, %c16384_i64 : i64
    %state_17 = tt.addptr %GroupEntry, %state_16 : !tt.ptr<f32>, i64
    %state_18 = tt.splat %state_17 : !tt.ptr<f32> -> tensor<16x128x!tt.ptr<f32>>
    %state_19 = tt.addptr %state_18, %state_offsets_9 : tensor<16x128x!tt.ptr<f32>>, tensor<16x128xi32>
    %state_20 = tt.load %state_19 : tensor<16x128x!tt.ptr<f32>>
    %0 = arith.subi %num_groups, %c1_i32 : i32
    %1 = arith.extsi %planes : i32 to i64
    %state_21 = scf.for %group = %c1_i32 to %0 step %c1_i32 iter_args(%state_22 = %state_20) -> (tensor<16x128xf32>)  : i32 {
      %plane = arith.muli %group, %planes : i32
      %plane_23 = arith.addi %plane, %sequence_head : i32
      %plane_24 = arith.extsi %plane_23 : i32 to i64
      %transfer = arith.muli %plane_24, %c16384_i64 : i64
      %transfer_25 = tt.addptr %GroupM, %transfer : !tt.ptr<bf16>, i64
      %transfer_26 = tt.splat %transfer_25 : !tt.ptr<bf16> -> tensor<128x128x!tt.ptr<bf16>>
      %transfer_27 = tt.addptr %transfer_26, %m_offsets_14 : tensor<128x128x!tt.ptr<bf16>>, tensor<128x128xi32>
      %transfer_28 = tt.load %transfer_27 : tensor<128x128x!tt.ptr<bf16>>
      %offset = tt.addptr %GroupB, %transfer : !tt.ptr<f32>, i64
      %offset_29 = tt.splat %offset : !tt.ptr<f32> -> tensor<16x128x!tt.ptr<f32>>
      %offset_30 = tt.addptr %offset_29, %state_offsets_9 : tensor<16x128x!tt.ptr<f32>>, tensor<16x128xi32>
      %offset_31 = tt.load %offset_30 : tensor<16x128x!tt.ptr<f32>>
      %state_32 = arith.truncf %state_22 : tensor<16x128xf32> to tensor<16x128xbf16>
      %state_33 = tt.dot %state_32, %transfer_28, %offset_31 : tensor<16x128xbf16> * tensor<128x128xbf16> -> tensor<16x128xf32>
      %2 = arith.addi %plane_24, %1 : i64
      %3 = arith.muli %2, %c16384_i64 : i64
      %4 = tt.addptr %GroupEntry, %3 : !tt.ptr<f32>, i64
      %5 = tt.splat %4 : !tt.ptr<f32> -> tensor<16x128x!tt.ptr<f32>>
      %6 = tt.addptr %5, %state_offsets_9 : tensor<16x128x!tt.ptr<f32>>, tensor<16x128xi32>
      tt.store %6, %state_33 : tensor<16x128x!tt.ptr<f32>>
      scf.yield %state_33 : tensor<16x128xf32>
    } {tt.num_stages = 3 : i32}
    tt.return
  }
}
