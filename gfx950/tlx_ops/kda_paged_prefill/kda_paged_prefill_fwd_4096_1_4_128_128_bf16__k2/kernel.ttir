module attributes {"ttg.cluster-dim-x" = 1 : i32, "ttg.cluster-dim-y" = 1 : i32, "ttg.cluster-dim-z" = 1 : i32} {
  tt.func public @_chain_groups_kernel(%GroupEntry: !tt.ptr<f32> {tt.divisibility = 16 : i32, tt.pointer_range = 32 : i32}, %GroupB: !tt.ptr<f32> {tt.divisibility = 16 : i32, tt.pointer_range = 32 : i32}, %GroupM: !tt.ptr<bf16> {tt.divisibility = 16 : i32, tt.pointer_range = 32 : i32}, %num_groups: i32 {tt.divisibility = 16 : i32}) attributes {noinline = false} {
    %c1_i32 = arith.constant 1 : i32
    %c16384_i64 = arith.constant 16384 : i64
    %m_offsets = arith.constant dense<128> : tensor<128x1xi32>
    %state_offsets = arith.constant dense<128> : tensor<16x1xi32>
    %c16_i32 = arith.constant 16 : i32
    %value_block = tt.get_program_id x : i32
    %sequence_head = tt.get_program_id y : i32
    %planes = tt.get_num_programs y : i32
    %values = arith.muli %value_block, %c16_i32 : i32
    %values_0 = tt.make_range {end = 16 : i32, start = 0 : i32} : tensor<16xi32>
    %values_1 = tt.splat %values : i32 -> tensor<16xi32>
    %values_2 = arith.addi %values_1, %values_0 : tensor<16xi32>
    %keys = tt.make_range {end = 128 : i32, start = 0 : i32} : tensor<128xi32>
    %state_offsets_3 = tt.expand_dims %values_2 {axis = 1 : i32} : tensor<16xi32> -> tensor<16x1xi32>
    %state_offsets_4 = arith.muli %state_offsets_3, %state_offsets : tensor<16x1xi32>
    %state_offsets_5 = tt.expand_dims %keys {axis = 0 : i32} : tensor<128xi32> -> tensor<1x128xi32>
    %state_offsets_6 = tt.broadcast %state_offsets_4 : tensor<16x1xi32> -> tensor<16x128xi32>
    %state_offsets_7 = tt.broadcast %state_offsets_5 : tensor<1x128xi32> -> tensor<16x128xi32>
    %state_offsets_8 = arith.addi %state_offsets_6, %state_offsets_7 : tensor<16x128xi32>
    %m_offsets_9 = tt.expand_dims %keys {axis = 1 : i32} : tensor<128xi32> -> tensor<128x1xi32>
    %m_offsets_10 = arith.muli %m_offsets_9, %m_offsets : tensor<128x1xi32>
    %m_offsets_11 = tt.broadcast %m_offsets_10 : tensor<128x1xi32> -> tensor<128x128xi32>
    %m_offsets_12 = tt.broadcast %state_offsets_5 : tensor<1x128xi32> -> tensor<128x128xi32>
    %m_offsets_13 = arith.addi %m_offsets_11, %m_offsets_12 : tensor<128x128xi32>
    %state = arith.addi %planes, %sequence_head : i32
    %state_14 = arith.extsi %state : i32 to i64
    %state_15 = arith.muli %state_14, %c16384_i64 : i64
    %state_16 = tt.addptr %GroupEntry, %state_15 : !tt.ptr<f32>, i64
    %state_17 = tt.splat %state_16 : !tt.ptr<f32> -> tensor<16x128x!tt.ptr<f32>>
    %state_18 = tt.addptr %state_17, %state_offsets_8 : tensor<16x128x!tt.ptr<f32>>, tensor<16x128xi32>
    %state_19 = tt.load %state_18 : tensor<16x128x!tt.ptr<f32>>
    %0 = arith.subi %num_groups, %c1_i32 : i32
    %1 = arith.extsi %planes : i32 to i64
    %state_20 = scf.for %group = %c1_i32 to %0 step %c1_i32 iter_args(%state_21 = %state_19) -> (tensor<16x128xf32>)  : i32 {
      %plane = arith.muli %group, %planes : i32
      %plane_22 = arith.addi %plane, %sequence_head : i32
      %plane_23 = arith.extsi %plane_22 : i32 to i64
      %transfer = arith.muli %plane_23, %c16384_i64 : i64
      %transfer_24 = tt.addptr %GroupM, %transfer : !tt.ptr<bf16>, i64
      %transfer_25 = tt.splat %transfer_24 : !tt.ptr<bf16> -> tensor<128x128x!tt.ptr<bf16>>
      %transfer_26 = tt.addptr %transfer_25, %m_offsets_13 : tensor<128x128x!tt.ptr<bf16>>, tensor<128x128xi32>
      %transfer_27 = tt.load %transfer_26 : tensor<128x128x!tt.ptr<bf16>>
      %offset = tt.addptr %GroupB, %transfer : !tt.ptr<f32>, i64
      %offset_28 = tt.splat %offset : !tt.ptr<f32> -> tensor<16x128x!tt.ptr<f32>>
      %offset_29 = tt.addptr %offset_28, %state_offsets_8 : tensor<16x128x!tt.ptr<f32>>, tensor<16x128xi32>
      %offset_30 = tt.load %offset_29 : tensor<16x128x!tt.ptr<f32>>
      %state_31 = arith.truncf %state_21 : tensor<16x128xf32> to tensor<16x128xbf16>
      %state_32 = tt.dot %state_31, %transfer_27, %offset_30 : tensor<16x128xbf16> * tensor<128x128xbf16> -> tensor<16x128xf32>
      %2 = arith.addi %plane_23, %1 : i64
      %3 = arith.muli %2, %c16384_i64 : i64
      %4 = tt.addptr %GroupEntry, %3 : !tt.ptr<f32>, i64
      %5 = tt.splat %4 : !tt.ptr<f32> -> tensor<16x128x!tt.ptr<f32>>
      %6 = tt.addptr %5, %state_offsets_8 : tensor<16x128x!tt.ptr<f32>>, tensor<16x128xi32>
      tt.store %6, %state_32 : tensor<16x128x!tt.ptr<f32>>
      scf.yield %state_32 : tensor<16x128xf32>
    } {tt.num_stages = 3 : i32}
    tt.return
  }
}
