    %15 = tt.splat %ids_ptr : !tt.ptr<i32> -> tensor<4x1x!tt.ptr<i32>>
    %16 = tt.addptr %15, %14 : tensor<4x1x!tt.ptr<i32>>, tensor<4x1xi64>
    %17 = tt.broadcast %16 : tensor<4x1x!tt.ptr<i32>> -> tensor<4x8x!tt.ptr<i32>>
    %18 = tt.addptr %17, %10 : tensor<4x8x!tt.ptr<i32>>, tensor<4x8xi32>
    tt.store %18, %picked_ids_188, %out_mask_231 : tensor<4x8x!tt.ptr<i32>>
    tt.return
  }
}
