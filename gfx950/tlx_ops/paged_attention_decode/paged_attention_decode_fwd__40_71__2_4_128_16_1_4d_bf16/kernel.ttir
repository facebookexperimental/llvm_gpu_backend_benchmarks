          %vis_144 = tt.broadcast %vis : tensor<1x64xi1> -> tensor<16x64xi1>
          %vis_145 = arith.andi %vis_144, %vis_143 : tensor<16x64xi1>
          %qks_146 = arith.select %vis_145, %qks, %cst_0 : tensor<16x64xi1>, tensor<16x64xf32>
          scf.yield %qks_146 : tensor<16x64xf32>
        }
        %value = "tt.reduce"(%5) <{axis = 1 : i32, reduction_ordering = "unordered"}> ({
        ^bb0(%m_ij: f32, %m_ij_133: f32):
          %value_134 = arith.maxnumf %m_ij, %m_ij_133 : f32
          tt.reduce.return %value_134 : f32
        }) : (tensor<16x64xf32>) -> tensor<16xf32>
        %m_new = arith.maxnumf %m_i, %value : tensor<16xf32>
        %p = tt.expand_dims %m_new {axis = 1 : i32} : tensor<16xf32> -> tensor<16x1xf32>
        %p_121 = tt.broadcast %p : tensor<16x1xf32> -> tensor<16x64xf32>
        %p_122 = arith.subf %5, %p_121 : tensor<16x64xf32>
        %p_123 = math.exp2 %p_122 : tensor<16x64xf32>
        %alpha = arith.subf %m_i, %m_new : tensor<16xf32>
        %alpha_124 = math.exp2 %alpha : tensor<16xf32>
        %l_i_125 = arith.mulf %l_i, %alpha_124 : tensor<16xf32>
        %l_i_126 = "tt.reduce"(%p_123) <{axis = 1 : i32, reduction_ordering = "unordered"}> ({
        ^bb0(%l_i_133: f32, %l_i_134: f32):
          %l_i_135 = arith.addf %l_i_133, %l_i_134 : f32
          tt.reduce.return %l_i_135 : f32
        }) : (tensor<16x64xf32>) -> tensor<16xf32>
        %l_i_127 = arith.addf %l_i_125, %l_i_126 : tensor<16xf32>
        %acc_128 = tt.expand_dims %alpha_124 {axis = 1 : i32} : tensor<16xf32> -> tensor<16x1xf32>
        %acc_129 = tt.broadcast %acc_128 : tensor<16x1xf32> -> tensor<16x128xf32>
        %acc_130 = arith.mulf %acc_112, %acc_129 : tensor<16x128xf32>
        %acc_131 = arith.truncf %p_123 : tensor<16x64xf32> to tensor<16x64xbf16>
        %acc_132 = tt.dot %acc_131, %v_115, %acc_130 : tensor<16x64xbf16> * tensor<64x128xbf16> -> tensor<16x128xf32>
        scf.yield %m_new, %l_i_127, %acc_132 : tensor<16xf32>, tensor<16xf32>, tensor<16x128xf32>
      }
      scf.yield %acc#0, %acc#1, %acc#2 : tensor<16xf32>, tensor<16xf32>, tensor<16x128xf32>
    } else {
      scf.yield %cst_4, %cst_2, %cst_1 : tensor<16xf32>, tensor<16xf32>, tensor<16x128xf32>
    }
    %has_kv = arith.cmpf ogt, %1#1, %cst_2 : tensor<16xf32>
    %o_part_40 = tt.expand_dims %has_kv {axis = 1 : i32} : tensor<16xi1> -> tensor<16x1xi1>
    %o_part_41 = tt.expand_dims %1#1 {axis = 1 : i32} : tensor<16xf32> -> tensor<16x1xf32>
    %o_part_42 = arith.select %o_part_40, %o_part_41, %o_part : tensor<16x1xi1>, tensor<16x1xf32>
    %o_part_43 = tt.broadcast %o_part_42 : tensor<16x1xf32> -> tensor<16x128xf32>
    %o_part_44 = arith.divf %1#2, %o_part_43 : tensor<16x128xf32>
    %o_part_45 = tt.broadcast %o_part_40 : tensor<16x1xi1> -> tensor<16x128xi1>
    %o_part_46 = arith.select %o_part_45, %o_part_44, %cst_1 : tensor<16x128xi1>, tensor<16x128xf32>
    %lse_part_47 = arith.select %has_kv, %1#1, %lse_part : tensor<16xi1>, tensor<16xf32>
    %lse_part_48 = math.log2 %lse_part_47 : tensor<16xf32>
    %lse_part_49 = arith.addf %1#0, %lse_part_48 : tensor<16xf32>
    %lse_part_50 = arith.select %has_kv, %lse_part_49, %cst_4 : tensor<16xi1>, tensor<16xf32>
    %mid_ptrs = arith.muli %seq, %stride_mid_s : i32
    %mid_ptrs_51 = tt.addptr %Mid, %mid_ptrs : !tt.ptr<f32>, i32
    %mid_ptrs_52 = arith.muli %kv_head, %stride_mid_h : i32
    %mid_ptrs_53 = tt.addptr %mid_ptrs_51, %mid_ptrs_52 : !tt.ptr<f32>, i32
    %mid_ptrs_54 = arith.muli %split, %stride_mid_k : i32
    %mid_ptrs_55 = tt.addptr %mid_ptrs_53, %mid_ptrs_54 : !tt.ptr<f32>, i32
    %mid_ptrs_56 = tt.expand_dims %offs_g {axis = 1 : i32} : tensor<16xi32> -> tensor<16x1xi32>
    %mid_ptrs_57 = tt.splat %stride_mid_m : i32 -> tensor<16x1xi32>
    %mid_ptrs_58 = arith.muli %mid_ptrs_56, %mid_ptrs_57 : tensor<16x1xi32>
    %mid_ptrs_59 = tt.splat %mid_ptrs_55 : !tt.ptr<f32> -> tensor<16x1x!tt.ptr<f32>>
    %mid_ptrs_60 = tt.addptr %mid_ptrs_59, %mid_ptrs_58 : tensor<16x1x!tt.ptr<f32>>, tensor<16x1xi32>
    %mid_ptrs_61 = tt.broadcast %mid_ptrs_60 : tensor<16x1x!tt.ptr<f32>> -> tensor<16x128x!tt.ptr<f32>>
    %mid_ptrs_62 = tt.broadcast %q_ptrs_20 : tensor<1x128xi32> -> tensor<16x128xi32>
    %mid_ptrs_63 = tt.addptr %mid_ptrs_61, %mid_ptrs_62 : tensor<16x128x!tt.ptr<f32>>, tensor<16x128xi32>
    tt.store %mid_ptrs_63, %o_part_46 : tensor<16x128x!tt.ptr<f32>>
    %lse_ptrs = arith.muli %seq, %stride_lse_s : i32
    %lse_ptrs_64 = tt.addptr %Lse, %lse_ptrs : !tt.ptr<f32>, i32
    %lse_ptrs_65 = arith.muli %kv_head, %stride_lse_h : i32
    %lse_ptrs_66 = tt.addptr %lse_ptrs_64, %lse_ptrs_65 : !tt.ptr<f32>, i32
    %lse_ptrs_67 = arith.muli %split, %stride_lse_k : i32
    %lse_ptrs_68 = tt.addptr %lse_ptrs_66, %lse_ptrs_67 : !tt.ptr<f32>, i32
    %lse_ptrs_69 = tt.splat %lse_ptrs_68 : !tt.ptr<f32> -> tensor<16x!tt.ptr<f32>>
    %lse_ptrs_70 = tt.addptr %lse_ptrs_69, %offs_g : tensor<16x!tt.ptr<f32>>, tensor<16xi32>
    tt.store %lse_ptrs_70, %lse_part_50 : tensor<16x!tt.ptr<f32>>
    tt.return
  }
}
