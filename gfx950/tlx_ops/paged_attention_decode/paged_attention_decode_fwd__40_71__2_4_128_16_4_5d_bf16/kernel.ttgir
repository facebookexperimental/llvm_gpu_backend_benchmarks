    %lse_ptrs_90 = arith.addi %lse_ptrs_88, %lse_ptrs_89 : i32
    %lse_ptrs_91 = tt.splat %lse_ptrs_90 : i32 -> tensor<16xi32, #blocked2>
    %lse_ptrs_92 = arith.addi %offs_m_19, %lse_ptrs_91 : tensor<16xi32, #blocked2>
    %2 = ttg.convert_layout %lse_part_73 : tensor<16xf32, #ttg.slice<{dim = 1, parent = #mma}>> -> tensor<16xf32, #blocked2>
    amdg.buffer_store %2, %Lse[%lse_ptrs_92] : !tt.ptr<f32> -> tensor<16xf32, #blocked2>
    tt.return
  }
}
